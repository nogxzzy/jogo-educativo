                { kind: 'goblin_warrior', name: 'Goblin Guarda', x: 3, z: -26, hp: 95, atk: 17, def: 5, exp: 65, gold: 40, speed: 3.2, range: 2.1 },
                { kind: 'goblin_warrior_boss', spriteKey: 'goblin_warrior', name: 'Capitão Goblin Guerreiro', x: -2, z: -41, hp: 155, atk: 22, def: 7, exp: 130, gold: 85, speed: 3.4, range: 2.3, isElite: true },

                { kind: 'goblin_king', spriteKey: 'goblin_king', name: 'Goblin Rei Grakthar', x: 0, z: -72, hp: 360, atk: 30, def: 10, exp: 350, gold: 250, speed: 3.5, range: 2.7, isBoss: true }
            ];

            for (const cfg of spawns) {
                this._createEnemy(cfg);
            }
        }

        _createEnemy(cfg) {
            const spriteKey = cfg.spriteKey || cfg.kind;
            const tex = this.spriteFactory.getCharacterTexture(spriteKey);
            const size = cfg.isBoss ? 3.55 : cfg.isElite ? 2.85 : 2.35;
            const animator = new SpriteAnimator(this.scene, tex, {
                width: size,
                height: size
            });

            const y = this.worldManager.getTerrainHeight(cfg.x, cfg.z);
            animator.setPosition(cfg.x, y, cfg.z);

            const hpBar = this._createOverheadHpBar(cfg.isBoss ? 2.4 : 1.4);
            hpBar.group.position.set(cfg.x, y + size * 0.96, cfg.z);
            this.scene.add(hpBar.group);

            this.enemies.push({
                ...cfg,
                homePos: new THREE.Vector3(cfg.x, y, cfg.z),
                pos: new THREE.Vector3(cfg.x, y, cfg.z),
                patrolTarget: new THREE.Vector3(cfg.x, y, cfg.z),
                maxHp: cfg.hp,
                hp: cfg.hp,
                animator,
                hpBar,
                state: 'PATROL',
                attackTimer: 0,
                waitTimer: 1 + Math.random() * 2,
                respawnTimer: 0,
                specialCooldown: 4.5
            });
        }

        _createOverheadHpBar(width) {
            const group = new THREE.Group();
            const bg = new THREE.Mesh(
                new THREE.PlaneGeometry(width, 0.16),
                new THREE.MeshBasicMaterial({ color: 0x1a120b, side: THREE.DoubleSide })
            );
            const fill = new THREE.Mesh(
                new THREE.PlaneGeometry(width - 0.06, 0.10),
                new THREE.MeshBasicMaterial({ color: 0xd9383a, side: THREE.DoubleSide })
            );
            fill.position.z = 0.01;
            group.add(bg, fill);
            return { group, fill, width: width - 0.06 };
        }

        update(dt, cameraYaw, player, combatSystem, audioManager) {
            for (const e of this.enemies) {
                e.hpBar.group.rotation.set(0, cameraYaw, 0);

                if (e.state === 'DEAD') {
                    e.animator.setState('dead');
                    e.animator.update(dt, cameraYaw);
                    e.hpBar.group.visible = false;

                    if (!e.isBoss && !e.isElite) {
                        e.respawnTimer -= dt;
                        if (e.respawnTimer <= 0) {
                            e.state = 'PATROL';
                            e.hp = e.maxHp;
                            e.pos.copy(e.homePos);
                            e.hpBar.group.visible = true;
                            e.animator.setState('idle');
                        }
                    }
                    continue;
                }

                const ratio = Math.max(0, e.hp / e.maxHp);
                e.hpBar.fill.scale.x = Math.max(0.001, ratio);
                e.hpBar.fill.position.x = -(1 - ratio) * (e.hpBar.width * 0.5);

                if (e.attackTimer > 0) e.attackTimer -= dt;
                if (e.specialCooldown > 0) e.specialCooldown -= dt;

                const distPlayer = Math.hypot(player.pos.x - e.pos.x, player.pos.z - e.pos.z);
                const distHome = Math.hypot(e.pos.x - e.homePos.x, e.pos.z - e.homePos.z);
                const aggroRange = e.isBoss ? 14.5 : 10.5;
                const leashRange = e.isBoss ? 22.0 : 18.0;

                if (!player.isDead && distPlayer < aggroRange && distHome < leashRange) {
                    e.state = 'CHASE';
                } else if (distHome >= leashRange || player.isDead) {
                    e.state = 'PATROL';
                }

                if (e.state === 'CHASE') {
                    const dx = player.pos.x - e.pos.x;
                    const dz = player.pos.z - e.pos.z;
                    e.animator.facingAngle = Math.atan2(dx, dz);

                    if (distPlayer <= e.range) {
                        if (e.attackTimer <= 0) {
                            e.attackTimer = e.isBoss ? 1.35 : e.ranged ? 1.85 : 1.45;
                            e.animator.setState('attack', 0.35);

                            if (e.isBoss && e.specialCooldown <= 0) {
                                e.specialCooldown = 6.0;
                                combatSystem.performBossSlam(e, player, audioManager);
                            } else if (e.ranged) {
                                combatSystem.spawnArrow(e.pos, player.pos, e.atk, audioManager);
                            } else {
                                combatSystem.enemyMeleeHit(e, player, audioManager);
                            }
                        } else if (e.animator.state !== 'attack' && e.animator.state !== 'hurt') {
                            e.animator.setState('idle');
                        }
                    } else {
                        const len = Math.hypot(dx, dz);
                        e.pos.x += (dx / len) * e.speed * dt;
                        e.pos.z += (dz / len) * e.speed * dt;
                        if (e.animator.state !== 'hurt') e.animator.setState('walk');
                    }
                } else {
                    const dPatrol = Math.hypot(e.patrolTarget.x - e.pos.x, e.patrolTarget.z - e.pos.z);
                    if (dPatrol > 0.25) {
                        const dx = e.patrolTarget.x - e.pos.x;
                        const dz = e.patrolTarget.z - e.pos.z;
                        const len = Math.hypot(dx, dz);
                        e.pos.x += (dx / len) * (e.speed * 0.45) * dt;
                        e.pos.z += (dz / len) * (e.speed * 0.45) * dt;
                        e.animator.facingAngle = Math.atan2(dx, dz);
                        if (e.animator.state !== 'hurt') e.animator.setState('walk');
                    } else {
                        if (e.animator.state !== 'hurt') e.animator.setState('idle');
                        e.waitTimer -= dt;
                        if (e.waitTimer <= 0) {
                            e.waitTimer = 2.0 + Math.random() * 3.0;
                            const a = Math.random() * Math.PI * 2;
                            const r = 1.5 + Math.random() * 3.8;
                            e.patrolTarget.set(
                                e.homePos.x + Math.cos(a) * r,
                                0,
                                e.homePos.z + Math.sin(a) * r
                            );
                        }
                    }
                }

                this.worldManager.resolveCollisions(e.pos, 0.55);
                e.pos.y = this.worldManager.getTerrainHeight(e.pos.x, e.pos.z);
                e.animator.setPosition(e.pos.x, e.pos.y, e.pos.z);
                e.hpBar.group.position.set(e.pos.x, e.pos.y + (e.isBoss ? 3.3 : 2.3), e.pos.z);
                e.animator.update(dt, cameraYaw);
            }
        }
    }

    /* ==========================================================================
       13. CombatSystem — Golpes em tempo real, projéteis e números flutuantes
       ========================================================================== */
    class CombatSystem {
        constructor(scene, camera) {
            this.scene = scene;
            this.camera = camera;
            this.effects = [];
            this.projectiles = [];
            this.floatingTexts = [];
            this.layerEl = document.getElementById('floating-numbers-layer');
        }

        playerBasicAttack(player, enemyAI, questSystem, expSystem, inventorySystem, cameraController, audioManager, uiManager) {
            if (player.isDead || player.attackCooldown > 0) return false;

            const derived = player.getDerivedStats();
            player.attackCooldown = derived.attackCooldown;
            player.animator.setState('attack', 0.28);
            if (audioManager) audioManager.playSFX('sword');

            const angle = player.animator.facingAngle;
            const slashPos = new THREE.Vector3(
                player.pos.x + Math.sin(angle) * 1.35,
                player.pos.y + 1.05,
                player.pos.z + Math.cos(angle) * 1.35
            );
            this._spawnSlashArc(slashPos, angle, 0x9be7ff);

            let hitAny = false;
            const reach = 2.85;

            for (const e of enemyAI.enemies) {
                if (e.state === 'DEAD') continue;
                const dx = e.pos.x - player.pos.x;
                const dz = e.pos.z - player.pos.z;
                const dist = Math.hypot(dx, dz);
                if (dist > reach) continue;

                const toEnemyAngle = Math.atan2(dx, dz);
                let diff = toEnemyAngle - angle;
                while (diff > Math.PI) diff -= Math.PI * 2;
                while (diff < -Math.PI) diff += Math.PI * 2;

                if (Math.abs(diff) <= Math.PI * 0.62 || dist < 1.3) {
                    hitAny = true;
                    const isCrit = Math.random() < derived.critChance;
                    const variance = 0.88 + Math.random() * 0.24;
                    let dmg = Math.max(2, Math.round((derived.atk - e.def * 0.65) * variance));
                    if (isCrit) dmg = Math.round(dmg * 1.75);

                    e.hp -= dmg;
                    e.state = 'CHASE';
                    e.animator.setState('hurt', 0.24);

                    const push = e.isBoss ? 0.22 : 0.68;
                    if (dist > 0.01) {
                        e.pos.x += (dx / dist) * push;
                        e.pos.z += (dz / dist) * push;
                    }

                    this.spawnFloatingText(
                        e.pos.x,
                        e.pos.y + 2.1,
                        e.pos.z,
                        isCrit ? `CRÍTICO! -${dmg}` : `-${dmg}`,
                        isCrit ? '#ffd166' : '#ffffff',
                        isCrit
                    );

                    if (e.hp <= 0) {
                        this._handleEnemyDeath(e, questSystem, expSystem, inventorySystem, audioManager, uiManager);
                    }
                }
            }

            if (hitAny) {
                if (audioManager) audioManager.playSFX('hit');
                cameraController.triggerShake(0.22, 0.14);
            }

            return true;
        }

        _handleEnemyDeath(enemy, questSystem, expSystem, inventorySystem, audioManager, uiManager) {
            enemy.hp = 0;
            enemy.state = 'DEAD';
            enemy.respawnTimer = 28;
            enemy.animator.setState('dead');
            if (audioManager) audioManager.playSFX('monster_die');

            expSystem.gainExp(enemy.exp);
            inventorySystem.gold += enemy.gold;

            this.spawnFloatingText(enemy.pos.x, enemy.pos.y + 2.4, enemy.pos.z, `+${enemy.exp} EXP`, '#7ae582', false);

            if (enemy.isBoss) {
                inventorySystem.addItem('crown_goblin', 1);
                uiManager.showToast('Você derrotou o Goblin Rei Grakthar! Retorne ao Ancião Aldric no vilarejo!');
            } else if (Math.random() < 0.35) {
                inventorySystem.addItem('potion_red', 1);
                uiManager.showToast(`${enemy.name} derrubou uma Poção Vermelha!`);
            }

            questSystem.notifyKill(enemy.kind);
        }

        enemyMeleeHit(enemy, player, audioManager) {
            if (player.isDead || player.invulnTimer > 0) return;
            const derived = player.getDerivedStats();
            const dmg = Math.max(1, Math.round(enemy.atk - derived.def * 0.55));
            player.hp = Math.max(0, player.hp - dmg);
            player.animator.setState('hurt', 0.22);
            if (audioManager) audioManager.playSFX('player_hurt');

            this.spawnFloatingText(player.pos.x, player.pos.y + 2.2, player.pos.z, `-${dmg}`, '#ff595e', false);

            if (player.hp <= 0) player.isDead = true;
        }

        performBossSlam(boss, player, audioManager) {
            const ringGeo = new THREE.RingGeometry(0.5, 4.4, 28);
            ringGeo.rotateX(-Math.PI / 2);
            const ringMat = new THREE.MeshBasicMaterial({
                color: 0xff595e,
                transparent: true,
                opacity: 0.75,
                side: THREE.DoubleSide
            });
            const ring = new THREE.Mesh(ringGeo, ringMat);
            ring.position.set(boss.pos.x, boss.pos.y + 0.12, boss.pos.z);
            this.scene.add(ring);
            this.effects.push({ mesh: ring, life: 0.45, maxLife: 0.45, scaleExpand: true });

            if (audioManager) audioManager.playSFX('hit');

            const dist = Math.hypot(player.pos.x - boss.pos.x, player.pos.z - boss.pos.z);
            if (dist <= 4.5 && player.invulnTimer <= 0 && !player.isDead) {
                const derived = player.getDerivedStats();
                const dmg = Math.max(4, Math.round(boss.atk * 1.35 - derived.def * 0.5));
                player.hp = Math.max(0, player.hp - dmg);
                player.animator.setState('hurt', 0.3);
                this.spawnFloatingText(player.pos.x, player.pos.y + 2.3, player.pos.z, `IMPACTO! -${dmg}`, '#ff2a2a', true);
                if (player.hp <= 0) player.isDead = true;
            }
        }

        spawnArrow(fromPos, targetPos, atk, audioManager) {
            const geo = new THREE.CylinderGeometry(0.04, 0.04, 1.1, 6);
            geo.rotateX(Math.PI / 2);
            const mat = new THREE.MeshBasicMaterial({ color: 0xf4a261 });
            const mesh = new THREE.Mesh(geo, mat);
            mesh.position.set(fromPos.x, fromPos.y + 1.1, fromPos.z);

            const dx = targetPos.x - fromPos.x;
            const dz = targetPos.z - fromPos.z;
            const len = Math.hypot(dx, dz) || 1;
            mesh.rotation.y = Math.atan2(dx, dz);

            this.scene.add(mesh);
            if (audioManager) audioManager.playSFX('arrow');

            this.projectiles.push({
                mesh,
                vx: (dx / len) * 14.5,
                vz: (dz / len) * 14.5,
                atk,
                life: 1.4
            });
        }

        _spawnSlashArc(pos, angle, colorHex) {
            const geo = new THREE.RingGeometry(0.7, 1.65, 16, 1, -Math.PI * 0.45, Math.PI * 0.9);
            geo.rotateX(-Math.PI / 2);
            const mat = new THREE.MeshBasicMaterial({
                color: colorHex,
                transparent: true,
                opacity: 0.85,
                side: THREE.DoubleSide
            });
            const mesh = new THREE.Mesh(geo, mat);
            mesh.position.copy(pos);
            mesh.rotation.y = angle - Math.PI / 2;
            this.scene.add(mesh);
            this.effects.push({ mesh, life: 0.18, maxLife: 0.18 });
        }

        spawnFloatingText(x, y, z, text, color = '#ffffff', isLarge = false) {
            if (!this.layerEl) return;
            const el = document.createElement('div');
            el.className = `floating-dmg ${isLarge ? 'crit' : ''}`;
            el.textContent = text;
            el.style.color = color;
            this.layerEl.appendChild(el);

            this.floatingTexts.push({
                el,
                worldPos: new THREE.Vector3(x, y, z),
                life: 0.95,
                maxLife: 0.95
            });
        }

        update(dt, player, audioManager) {
            for (let i = this.effects.length - 1; i >= 0; i--) {
                const ef = this.effects[i];
                ef.life -= dt;
                if (ef.life <= 0) {
                    this.scene.remove(ef.mesh);
                    ef.mesh.geometry.dispose();
                    ef.mesh.material.dispose();
                    this.effects.splice(i, 1);
                } else {
                    const t = ef.life / ef.maxLife;
                    ef.mesh.material.opacity = t * 0.85;
                    if (ef.scaleExpand) {
                        const s = 1 + (1 - t) * 0.35;
                        ef.mesh.scale.set(s, 1, s);
                    }
                }
            }

            for (let i = this.projectiles.length - 1; i >= 0; i--) {
                const p = this.projectiles[i];
                p.life -= dt;
                p.mesh.position.x += p.vx * dt;
                p.mesh.position.z += p.vz * dt;

                const distPlayer = Math.hypot(p.mesh.position.x - player.pos.x, p.mesh.position.z - player.pos.z);
                if (distPlayer < 0.85 && !player.isDead && player.invulnTimer <= 0) {
                    const derived = player.getDerivedStats();
                    const dmg = Math.max(1, Math.round(p.atk - derived.def * 0.45));
                    player.hp = Math.max(0, player.hp - dmg);
                    player.animator.setState('hurt', 0.2);
                    if (audioManager) audioManager.playSFX('player_hurt');
                    this.spawnFloatingText(player.pos.x, player.pos.y + 2.1, player.pos.z, `-${dmg}`, '#ff595e', false);
                    if (player.hp <= 0) player.isDead = true;
                    p.life = 0;
                }

                if (p.life <= 0) {
                    this.scene.remove(p.mesh);
                    p.mesh.geometry.dispose();
                    p.mesh.material.dispose();
                    this.projectiles.splice(i, 1);
                }
            }

            const halfW = window.innerWidth * 0.5;
            const halfH = window.innerHeight * 0.5;
            for (let i = this.floatingTexts.length - 1; i >= 0; i--) {
                const ft = this.floatingTexts[i];
                ft.life -= dt;
                ft.worldPos.y += dt * 1.45;
                if (ft.life <= 0) {
                    ft.el.remove();
                    this.floatingTexts.splice(i, 1);
                } else {
                    const proj = ft.worldPos.clone().project(this.camera);
                    const sx = proj.x * halfW + halfW;
                    const sy = -proj.y * halfH + halfH;
                    ft.el.style.transform = `translate(${sx}px, ${sy}px)`;
                    ft.el.style.opacity = Math.min(1, (ft.life / ft.maxLife) * 1.5);
                }
            }
        }
    }

    /* ==========================================================================
       14. AudioManager — Música medieval dinâmica por região & SFX via Web Audio
       ========================================================================== */
    class AudioManager {
        constructor() {
            this.ctx = null;
            this.muted = false;
            this.currentRegion = 'village';
            this.bgmTimer = 0;
            this.noteStep = 0;
            this.ambientTimer = 0;
        }

        init() {
            if (!this.ctx) {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (AudioCtx) this.ctx = new AudioCtx();
            }
            if (this.ctx && this.ctx.state === 'suspended') {
                this.ctx.resume();
            }
        }

        toggleMute() {
            this.muted = !this.muted;
            return this.muted;
        }

        setRegion(region) {
            if (this.currentRegion !== region) {
                this.currentRegion = region;
                this.noteStep = 0;
            }
        }

        _playTone(freq, duration, type = 'triangle', gainVal = 0.08, delay = 0) {
            if (this.muted || !this.ctx) return;
            const now = this.ctx.currentTime + delay;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, now);

            gain.gain.setValueAtTime(0.0001, now);
            gain.gain.exponentialRampToValueAtTime(gainVal, now + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now);
            osc.stop(now + duration + 0.02);
        }

        playSFX(kind) {
            if (this.muted) return;
            this.init();
            if (!this.ctx) return;

            if (kind === 'step') {
                this._playTone(110 + Math.random() * 25, 0.06, 'sine', 0.025);
            } else if (kind === 'sword') {
                this._playTone(520, 0.09, 'sawtooth', 0.06);
                this._playTone(260, 0.14, 'triangle', 0.05, 0.03);
            } else if (kind === 'hit') {
                this._playTone(165, 0.12, 'square', 0.07);
                this._playTone(95, 0.16, 'sawtooth', 0.06, 0.02);
            } else if (kind === 'player_hurt') {
                this._playTone(190, 0.15, 'sawtooth', 0.08);
                this._playTone(130, 0.2, 'square', 0.07, 0.05);
            } else if (kind === 'arrow') {
                this._playTone(680, 0.08, 'triangle', 0.045);
            } else if (kind === 'monster_die') {
                this._playTone(220, 0.14, 'sawtooth', 0.06);
                this._playTone(146, 0.24, 'sawtooth', 0.06, 0.08);
            } else if (kind === 'potion') {
                this._playTone(440, 0.1, 'sine', 0.07);
                this._playTone(660, 0.16, 'sine', 0.07, 0.07);
            } else if (kind === 'level_up') {
                const notes = [523.25, 659.25, 783.99, 1046.5];
                notes.forEach((n, i) => this._playTone(n, 0.28, 'triangle', 0.09, i * 0.09));
            } else if (kind === 'ui_open') {
                this._playTone(392, 0.08, 'triangle', 0.05);
                this._playTone(523.25, 0.12, 'triangle', 0.05, 0.05);
            } else if (kind === 'ui_click') {
                this._playTone(480, 0.06, 'sine', 0.045);
            }
        }

        update(dt) {
            if (this.muted || !this.ctx || this.ctx.state !== 'running') return;

            const stepInterval = this.currentRegion === 'boss' ? 0.32 : 0.44;
            this.bgmTimer -= dt;
            if (this.bgmTimer <= 0) {
                this.bgmTimer = stepInterval;
                const melodies = {
                    village: [349.23, 440.0, 523.25, 587.33, 523.25, 440.0, 392.0, 440.0, 349.23, 329.63, 293.66, 349.23],
                    forest: [220.0, 261.63, 329.63, 293.66, 246.94, 220.0, 196.0, 220.0, 261.63, 246.94, 196.0, 164.81],
                    boss: [146.83, 146.83, 174.61, 164.81, 146.83, 220.0, 207.65, 174.61]
                };
                const seq = melodies[this.currentRegion] || melodies.village;
                const freq = seq[this.noteStep % seq.length];
                this.noteStep++;

                this._playTone(freq, stepInterval * 0.9, 'triangle', 0.026);
                if (this.noteStep % 4 === 1) {
                    this._playTone(freq * 0.5, stepInterval * 1.8, 'sine', 0.03);
                }
            }

            this.ambientTimer -= dt;
            if (this.ambientTimer <= 0) {
                this.ambientTimer = 4.5 + Math.random() * 4.0;
                if (this.currentRegion !== 'boss') {
                    this._playTone(1320 + Math.random() * 300, 0.07, 'sine', 0.015);
                    this._playTone(1580 + Math.random() * 250, 0.09, 'sine', 0.015, 0.09);
                }
            }
        }
    }

    /* ==========================================================================
       15. SaveSystem — Persistência em localStorage
       ========================================================================== */
    class SaveSystem {
        constructor(storageKey = 'ragnarok25d_oakhaven_save_v1') {
            this.storageKey = storageKey;
        }

        hasSave() {
            try {
                return Boolean(localStorage.getItem(this.storageKey));
            } catch (e) {
                return false;
            }
        }

        saveGame(game) {
            try {
                const payload = {
                    timestamp: Date.now(),
                    player: {
                        name: game.player.name,
                        skinType: game.player.skinType,
                        x: game.player.pos.x,
                        z: game.player.pos.z,
                        hp: game.player.hp,
                        sp: game.player.sp
                    },
                    exp: game.expSystem.serialize(),
                    inventory: game.inventorySystem.serialize(),
                    equipment: game.equipmentSystem.serialize(),
                    quests: game.questSystem.serialize()
                };
                localStorage.setItem(this.storageKey, JSON.stringify(payload));
                return true;
            } catch (e) {
                return false;
            }
        }

        loadGame(game) {
            try {
                const raw = localStorage.getItem(this.storageKey);
                if (!raw) return false;
                const data = JSON.parse(raw);

                game.expSystem.deserialize(data.exp);
                game.inventorySystem.deserialize(data.inventory);
                game.equipmentSystem.deserialize(data.equipment);
                game.questSystem.deserialize(data.quests);

                if (data.player) {
                    game.player.name = data.player.name || 'Sir Aldren';
                    if (data.player.skinType) game.player.setSkin(data.player.skinType);
                    game.player.pos.x = data.player.x ?? 0;
                    game.player.pos.z = data.player.z ?? 44;
                    game.player.pos.y = game.worldManager.getTerrainHeight(game.player.pos.x, game.player.pos.z);
                    game.player.recalculateVitals(false);
                    game.player.hp = Math.min(game.player.maxHp, data.player.hp ?? game.player.maxHp);
                    game.player.sp = Math.min(game.player.maxSp, data.player.sp ?? game.player.maxSp);
                    game.player.isDead = false;
                    game.player.animator.setState('idle');
                    game.player.animator.setPosition(game.player.pos.x, game.player.pos.y, game.player.pos.z);
                }
                return true;
            } catch (e) {
                return false;
            }
        }
    }

    /* ==========================================================================
       16. UIManager — HUD, Minimapa, Inventário, Atributos, Missões e Loja
       ========================================================================== */
    class UIManager {
        constructor(game) {
            this.game = game;
            this.activeModal = null;
            this.shopMode = 'merchant';
            this.toastTimer = 0;

            this.minimapCanvas = document.getElementById('minimap-canvas');
            this.minimapCtx = this.minimapCanvas ? this.minimapCanvas.getContext('2d') : null;
            this.toastEl = document.getElementById('toast-banner');

            this._bindButtons();
        }

        _bindButtons() {
            document.getElementById('btn-toggle-inv').onclick = () => this.toggleModal('inventory');
            document.getElementById('btn-toggle-stats').onclick = () => this.toggleModal('stats');
            document.getElementById('btn-toggle-quests').onclick = () => this.toggleModal('quests');
            document.getElementById('btn-toggle-menu').onclick = () => this.toggleModal('pause');

            document.querySelectorAll('[data-close-modal]').forEach(btn => {
                btn.onclick = () => this.closeAllModals();
            });

            document.getElementById('quick-slot-1').onclick = () => this.game.useQuickPotion('potion_red');
            document.getElementById('quick-slot-2').onclick = () => this.game.useQuickPotion('potion_blue');

            document.getElementById('btn-save-game').onclick = () => {
                const ok = this.game.saveSystem.saveGame(this.game);
                this.showToast(ok ? 'Jogo salvo com sucesso!' : 'Erro ao salvar o jogo.');
            };
            document.getElementById('btn-load-game').onclick = () => {
                const ok = this.game.saveSystem.loadGame(this.game);
                if (ok) {
                    this.closeAllModals();
                    this.showToast('Progresso carregado!');
                } else {
                    this.showToast('Nenhum salvamento encontrado.');
                }
            };
            document.getElementById('btn-toggle-audio').onclick = () => {
                const muted = this.game.audioManager.toggleMute();
                document.getElementById('btn-toggle-audio').textContent = muted ? 'Áudio: Desativado' : 'Áudio: Ativado';
            };
            document.getElementById('btn-respawn').onclick = () => {
                this.game.player.respawnAtVillage();
                document.getElementById('death-modal').classList.add('hidden');
                this.showToast('Você retornou em segurança ao Vilarejo de Oakhaven.');
            };
            document.getElementById('btn-victory-continue').onclick = () => {
                document.getElementById('victory-modal').classList.add('hidden');
            };
        }

        isAnyModalOpen() {
            return Boolean(this.activeModal) || this.game.dialogueSystem.isOpen;
        }

        toggleModal(name) {
            if (this.game.dialogueSystem.isOpen) {
                this.game.dialogueSystem.close();
            }
            if (this.activeModal === name) {
                this.closeAllModals();
                return;
            }
            this.closeAllModals(true);
            this.activeModal = name;
            const el = document.getElementById(`modal-${name}`);
            if (el) {
                el.classList.remove('hidden');
                this.game.audioManager.playSFX('ui_open');
                this.refreshActiveModal();
            }
        }

        openShop(mode = 'merchant') {
            this.shopMode = mode;
            this.toggleModal('shop');
        }

        closeAllModals(silent = false) {
            this.activeModal = null;
            ['inventory', 'stats', 'quests', 'shop', 'pause'].forEach(m => {
                const el = document.getElementById(`modal-${m}`);
                if (el) el.classList.add('hidden');
            });
            if (!silent) this.game.audioManager.playSFX('ui_click');
        }

        showToast(msg) {
            if (!this.toastEl) return;
            this.toastEl.textContent = msg;
            this.toastEl.classList.remove('hidden');
            this.toastTimer = 3.6;
        }

        showVictoryModal() {
            document.getElementById('victory-modal').classList.remove('hidden');
            this.game.audioManager.playSFX('level_up');
        }

        refreshActiveModal() {
            if (this.activeModal === 'inventory') this._renderInventory();
            if (this.activeModal === 'stats') this._renderStats();
            if (this.activeModal === 'quests') this._renderQuests();
            if (this.activeModal === 'shop') this._renderShop();
        }

        _renderInventory() {
            const { inventorySystem, equipmentSystem, spriteFactory, player } = this.game;
            document.getElementById('inv-gold-value').textContent = `${inventorySystem.gold} Zeny`;

            const equipContainer = document.getElementById('equip-slots-list');
            equipContainer.innerHTML = '';
            const slotLabels = {
                weapon: 'Espada',
                shield: 'Escudo',
                armor: 'Armadura',
                boots: 'Botas',
                accessory: 'Acessório'
            };

            for (const [slotKey, label] of Object.entries(slotLabels)) {
                const item = equipmentSystem.slots[slotKey];
                const row = document.createElement('div');
                row.className = 'equip-row';
                if (item) {
                    row.innerHTML = `
                        <img src="${spriteFactory.getItemIconURL(item.icon)}" alt="${item.name}">
                        <div class="equip-info">
                            <span class="equip-slot-tag">${label}</span>
                            <strong>${item.name}</strong>
                        </div>
                        <button class="ro-btn small">Remover</button>
                    `;
                    row.querySelector('button').onclick = () => {
                        equipmentSystem.unequip(slotKey, inventorySystem);
                        player.recalculateVitals(false);
                        this.refreshActiveModal();
                    };
                } else {
                    row.innerHTML = `
                        <div class="equip-empty-icon"></div>
                        <div class="equip-info">
                            <span class="equip-slot-tag">${label}</span>
                            <span style="color:#8d816c;">Vazio</span>
                        </div>
                    `;
                }
                equipContainer.appendChild(row);
            }

            const grid = document.getElementById('inventory-grid');
            grid.innerHTML = '';
            for (let i = 0; i < inventorySystem.maxSlots; i++) {
                const item = inventorySystem.items[i];
                const cell = document.createElement('div');
                cell.className = `inv-slot ${item ? 'filled' : ''}`;
                if (item) {
                    cell.innerHTML = `
                        <img src="${spriteFactory.getItemIconURL(item.icon)}" alt="${item.name}">
                        ${item.qty > 1 ? `<span class="item-qty">${item.qty}</span>` : ''}
                        <div class="item-tooltip">
                            <strong>${item.name}</strong>
                            <p>${item.desc}</p>
                            <small>${item.type === 'equipment' ? 'Clique para Equipar' : item.type === 'consumable' ? 'Clique para Usar' : 'Relíquia'}</small>
                        </div>
                    `;
                    cell.onclick = () => {
                        const res = inventorySystem.useItem(item.id, player, equipmentSystem);
                        if (res.ok) {
                            player.recalculateVitals(false);
                            this.game.audioManager.playSFX(res.kind === 'potion' ? 'potion' : 'ui_click');
                            this.showToast(res.kind === 'equip' ? `Equipado: ${item.name}` : `Usou: ${item.name}`);
                            this.refreshActiveModal();
                        } else if (res.reason) {
                            this.showToast(res.reason);
                        }
                    };
                }
                grid.appendChild(cell);
            }
        }

        _renderStats() {
            const { expSystem, player } = this.game;
            const derived = player.getDerivedStats();

            document.getElementById('stat-points-avail').textContent = expSystem.statPoints;
            const statList = document.getElementById('base-stats-list');
            statList.innerHTML = '';

            const labels = [
                { key: 'str', name: 'FOR (Força)', desc: 'Aumenta o Dano Físico' },
                { key: 'agi', name: 'AGI (Agilidade)', desc: 'Velocidade de Ataque e Movimento' },
                { key: 'vit', name: 'VIT (Vitalidade)', desc: 'HP Máximo e Defesa Física' },
                { key: 'int', name: 'INT (Inteligência)', desc: 'SP Máximo e Regeneração' },
                { key: 'dex', name: 'DES (Destreza)', desc: 'Precisão e Estabilidade do Golpe' },
                { key: 'luk', name: 'SOR (Sorte)', desc: 'Chance de Acerto Crítico' }
            ];

            for (const s of labels) {
                const row = document.createElement('div');
                row.className = 'stat-row';
                row.innerHTML = `
                    <div>
                        <strong>${s.name}</strong>
                        <small>${s.desc}</small>
                    </div>
                    <div class="stat-controls">
                        <span class="stat-val">${expSystem.stats[s.key]}</span>
                        <button class="ro-btn small primary" ${expSystem.statPoints <= 0 ? 'disabled' : ''}>+</button>
                    </div>
                `;
                row.querySelector('button').onclick = () => {
                    if (expSystem.allocateStat(s.key)) {
                        player.recalculateVitals(false);
                        this.game.audioManager.playSFX('ui_click');
                        this.refreshActiveModal();
                    }
                };
                statList.appendChild(row);
            }

            document.getElementById('derived-stats-box').innerHTML = `
                <div><span>Ataque Físico:</span> <strong>${derived.atk}</strong></div>
                <div><span>Defesa Física:</span> <strong>${derived.def}</strong></div>
                <div><span>Vida Máxima:</span> <strong>${derived.maxHp}</strong></div>
                <div><span>Mana Máxima:</span> <strong>${derived.maxSp}</strong></div>
                <div><span>Chance Crítica:</span> <strong>${Math.round(derived.critChance * 100)}%</strong></div>
                <div><span>Velocidade:</span> <strong>${derived.moveSpeed.toFixed(1)}</strong></div>
            `;
        }

        _renderQuests() {
            const { questSystem, expSystem, inventorySystem } = this.game;
            const list = document.getElementById('quest-list-container');
            list.innerHTML = '';

            const statusMap = {
                available: { label: 'Disponível', cls: 'badge-avail' },
                active: { label: 'Em Andamento', cls: 'badge-active' },
                ready: { label: 'Pronta para Entregar!', cls: 'badge-ready' },
                completed: { label: 'Concluída', cls: 'badge-done' }
            };

            for (const q of questSystem.quests) {
                const st = statusMap[q.status] || statusMap.available;
                const card = document.createElement('div');
                card.className = `quest-card ${q.status}`;
                card.innerHTML = `
                    <div class="quest-header">
                        <strong>${q.title}</strong>
                        <span class="quest-badge ${st.cls}">${st.label}</span>
                    </div>
                    <p class="quest-desc">${q.description}</p>
                    <div class="quest-progress">
                        <span>Objetivo: ${q.objectiveText}</span>
                        <strong>${q.current} / ${q.required}</strong>
                    </div>
                    <div class="quest-footer">
                        <small>Recompensa: ${q.rewards.exp} EXP • ${q.rewards.gold} Zeny</small>
                        ${q.status === 'ready' ? '<button class="ro-btn small primary">Resgatar Recompensa</button>' : ''}
                    </div>
                `;
                const claimBtn = card.querySelector('button');
                if (claimBtn) {
                    claimBtn.onclick = () => {
                        questSystem.claimReward(q.id, expSystem, inventorySystem);
                        this.showToast(`Recompensa de "${q.title}" resgatada!`);
                        this.refreshActiveModal();
                    };
                }
                list.appendChild(card);
            }
        }

        _renderShop() {
            const { inventorySystem, spriteFactory } = this.game;
            const catalogIds = this.shopMode === 'blacksmith'
                ? ['sword_iron', 'sword_steel', 'shield_wood', 'shield_iron', 'armor_leather', 'armor_knight', 'boots_traveler']
                : ['potion_red', 'potion_blue', 'ring_luck', 'boots_traveler'];

            document.getElementById('shop-title').textContent =
                this.shopMode === 'blacksmith' ? 'Forja do Ferreiro Borin' : 'Empório da Comerciante Lira';
            document.getElementById('shop-gold-display').textContent = `Seu Ouro: ${inventorySystem.gold} Zeny`;

            const container = document.getElementById('shop-items-list');
            container.innerHTML = '';

            for (const id of catalogIds) {
                const item = ITEM_DATABASE[id];
                if (!item) continue;
                const row = document.createElement('div');
                row.className = 'shop-row';
                row.innerHTML = `
                    <img src="${spriteFactory.getItemIconURL(item.icon)}" alt="${item.name}">
                    <div class="shop-item-info">
                        <strong>${item.name}</strong>
                        <small>${item.desc}</small>
                    </div>
                    <button class="ro-btn small primary">${item.price} Zeny</button>
                `;
                row.querySelector('button').onclick = () => {
                    if (inventorySystem.gold < item.price) {
                        this.showToast('Zeny insuficiente!');
                        return;
                    }
                    if (inventorySystem.addItem(item.id, 1)) {
                        inventorySystem.gold -= item.price;
                        this.game.audioManager.playSFX('potion');
                        this.showToast(`Comprou: ${item.name}`);
                        this._renderShop();
                    } else {
                        this.showToast('Inventário cheio!');
                    }
                };
                container.appendChild(row);
            }
        }

        update(dt) {
            const { player, expSystem, inventorySystem, worldManager, npcSystem, enemyAI, questSystem, spriteFactory } = this.game;

            if (this.toastTimer > 0) {
                this.toastTimer -= dt;
                if (this.toastTimer <= 0 && this.toastEl) {
                    this.toastEl.classList.add('hidden');
                }
            }

            const hudPortrait = document.getElementById('hud-portrait');
            const expectedSrc = spriteFactory.getPortraitDataURL(player.skinType);
            if (hudPortrait && hudPortrait.src !== expectedSrc) {
                hudPortrait.src = expectedSrc;
            }

            document.getElementById('hud-char-name').textContent = player.name;
            document.getElementById('hud-level').textContent = `Nv. ${expSystem.level}`;
            document.getElementById('hud-hp-text').textContent = `${Math.ceil(player.hp)} / ${player.maxHp}`;
            document.getElementById('hud-sp-text').textContent = `${Math.ceil(player.sp)} / ${player.maxSp}`;
            document.getElementById('hud-hp-bar').style.width = `${Math.max(0, (player.hp / player.maxHp) * 100)}%`;
            document.getElementById('hud-sp-bar').style.width = `${Math.max(0, (player.sp / player.maxSp) * 100)}%`;
            document.getElementById('hud-exp-bar').style.width = `${Math.min(100, (expSystem.exp / expSystem.nextExp) * 100)}%`;

            const statBadge = document.getElementById('stat-point-badge');
            if (expSystem.statPoints > 0) {
                statBadge.classList.remove('hidden');
                statBadge.textContent = `+${expSystem.statPoints}`;
            } else {
                statBadge.classList.add('hidden');
            }

            document.getElementById('quick-hp-count').textContent = inventorySystem.getCount('potion_red');
            document.getElementById('quick-sp-count').textContent = inventorySystem.getCount('potion_blue');
            document.getElementById('hud-region-name').textContent = worldManager.regionNames[worldManager.currentRegion] || '';

            const activeQuest = questSystem.quests.find(q => q.status === 'active' || q.status === 'ready');
            const trackerEl = document.getElementById('hud-quest-tracker');
            if (activeQuest) {
                trackerEl.innerHTML = `
                    <div class="tracker-title">${activeQuest.title}</div>
                    <div class="tracker-obj">${activeQuest.objectiveText}: <strong>${activeQuest.current}/${activeQuest.required}</strong></div>
                `;
            } else {
                trackerEl.innerHTML = `<div class="tracker-title">Campanha Concluída!</div><div class="tracker-obj">Explore livremente Oakhaven.</div>`;
            }

            const nearNPC = npcSystem.findNearestNPC(player.pos, 3.4);
            const promptEl = document.getElementById('interact-prompt');
            if (nearNPC && !this.isAnyModalOpen() && !player.isDead) {
                promptEl.textContent = `[E] Conversar com ${nearNPC.name}`;
                promptEl.classList.remove('hidden');
            } else {
                promptEl.classList.add('hidden');
            }

            const boss = enemyAI.enemies.find(e => e.isBoss && e.state !== 'DEAD');
            const bossHud = document.getElementById('boss-hud-bar');
            if (boss && Math.hypot(player.pos.x - boss.pos.x, player.pos.z - boss.pos.z) < 17) {
                bossHud.classList.remove('hidden');
                document.getElementById('boss-name-label').textContent = boss.name;
                document.getElementById('boss-hp-fill').style.width = `${Math.max(0, (boss.hp / boss.maxHp) * 100)}%`;
            } else {
                bossHud.classList.add('hidden');
            }

            if (player.isDead) {
                document.getElementById('death-modal').classList.remove('hidden');
            }

            this._renderMinimap();
        }

        _renderMinimap() {
            if (!this.minimapCtx) return;
            const ctx = this.minimapCtx;
            const w = this.minimapCanvas.width;
            const h = this.minimapCanvas.height;
            const { player, npcSystem, enemyAI } = this.game;

            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = '#263b24';
            ctx.fillRect(0, 0, w, h);

            const toMap = (wx, wz) => [
                ((wx + 38) / 76) * w,
                ((wz + 92) / 160) * h
            ];

            ctx.fillStyle = 'rgba(212, 184, 134, 0.25)';
            ctx.fillRect(0, ((12 + 92) / 160) * h, w, h);

            ctx.fillStyle = '#3898c9';
            ctx.fillRect(0, ((9 + 92) / 160) * h, w, 5);

            const [bx, by] = toMap(0, 10.5);
            ctx.fillStyle = '#c98a4b';
            ctx.fillRect(bx - 5, by - 4, 10, 8);

            for (const npc of npcSystem.npcs) {
                const [nx, ny] = toMap(npc.pos.x, npc.pos.z);
                ctx.fillStyle = '#ffd166';
                ctx.beginPath();
                ctx.arc(nx, ny, 3, 0, Math.PI * 2);
                ctx.fill();
            }

            for (const e of enemyAI.enemies) {
                if (e.state === 'DEAD') continue;
                const [ex, ey] = toMap(e.pos.x, e.pos.z);
                ctx.fillStyle = e.isBoss ? '#ff2a2a' : '#ff6b6b';
                ctx.beginPath();
                ctx.arc(ex, ey, e.isBoss ? 4.5 : 2.5, 0, Math.PI * 2);
                ctx.fill();
            }

            const [px, py] = toMap(player.pos.x, player.pos.z);
            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(px, py, 3.8, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = '#1b263b';
            ctx.lineWidth = 1.5;
            ctx.stroke();
        }
    }

    /* ==========================================================================
       17. GameEngine — Loop Principal e Controle de Entradas
       ========================================================================== */
    class GameEngine {
        constructor() {
            this.canvas = document.getElementById('game-canvas');
            this.renderer = new THREE.WebGLRenderer({
                canvas: this.canvas,
                antialias: true,
                powerPreference: 'high-performance'
            });
            this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
            this.renderer.setSize(window.innerWidth, window.innerHeight);
            this.renderer.shadowMap.enabled = true;
            this.renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
            this.renderer.toneMappingExposure = 1.05;

            this.scene = new THREE.Scene();
            this.camera = new THREE.PerspectiveCamera(44, window.innerWidth / window.innerHeight, 0.5, 260);

            this.spriteFactory = new SpriteFactory();
            this.audioManager = new AudioManager();
            this.worldManager = new WorldManager(this.scene);
            this.cameraController = new CameraController(this.camera, this.canvas);

            this.expSystem = new ExperienceSystem();
            this.equipmentSystem = new EquipmentSystem();
            this.inventorySystem = new InventorySystem(20);
            this.questSystem = new QuestSystem();
            this.saveSystem = new SaveSystem();

            this.worldManager.buildWorld();

            this.player = new PlayerController(
                this.scene,
                this.spriteFactory,
                this.worldManager,
                this.expSystem,
                this.equipmentSystem
            );
            this.combatSystem = new CombatSystem(this.scene, this.camera);
            this.npcSystem = new NPCSystem(this.scene, this.spriteFactory, this.worldManager);
            this.enemyAI = new EnemyAI(this.scene, this.spriteFactory, this.worldManager);
            this.dialogueSystem = new DialogueSystem(this.spriteFactory, this.audioManager);
            this.uiManager = new UIManager(this);

            this.npcSystem.spawnVillageNPCs();
            this.enemyAI.spawnInitialEnemies();

            this._setupStarterKit();
            this._bindCallbacks();
            this._bindInputs();

            this.keys = {};
            this.isStarted = false;
            this.lastTime = performance.now();
            this.elapsedTime = 0;

            this._setupTitleScreen();
            this._loop(this.lastTime);
        }

        _setupStarterKit() {
            this.equipmentSystem.slots.weapon = JSON.parse(JSON.stringify(ITEM_DATABASE.sword_iron));
            this.equipmentSystem.slots.armor = JSON.parse(JSON.stringify(ITEM_DATABASE.armor_leather));
            this.inventorySystem.addItem('potion_red', 4);
            this.inventorySystem.addItem('potion_blue', 2);
            this.player.recalculateVitals(true);
        }

        _bindCallbacks() {
            this.expSystem.onLevelUp = (newLevel) => {
                this.player.recalculateVitals(true);
                this.audioManager.playSFX('level_up');
                this.combatSystem.spawnFloatingText(
                    this.player.pos.x,
                    this.player.pos.y + 2.6,
                    this.player.pos.z,
                    `LEVEL UP! Nv.${newLevel}`,
                    '#ffd166',
                    true
                );
                this.uiManager.showToast(`Parabéns! Você alcançou o Nível ${newLevel} (+4 Pontos de Atributo)!`);
            };

            this.questSystem.onQuestUpdate = (quest, kind) => {
                if (kind === 'accepted') {
                    this.uiManager.showToast(`Nova Missão: ${quest.title}`);
                } else if (kind === 'progress' && quest.status === 'ready') {
                    this.uiManager.showToast(`Objetivo concluído: ${quest.title}! Retorne para entregar.`);
                }
            };
        }

        _setupTitleScreen() {
            const titleOverlay = document.getElementById('title-screen');
            const btnContinue = document.getElementById('btn-title-continue');
            if (this.saveSystem.hasSave()) {
                btnContinue.classList.remove('hidden');
            }

            document.getElementById('preview-knight').src = this.spriteFactory.getPortraitDataURL('knight');
            document.getElementById('preview-guardian').src = this.spriteFactory.getPortraitDataURL('guardian');

            let selectedSkin = 'knight';
            document.querySelectorAll('.skin-card').forEach(card => {
                card.onclick = () => {
                    document.querySelectorAll('.skin-card').forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    selectedSkin = card.dataset.skin;
                    this.player.setSkin(selectedSkin);
                };
            });

            document.getElementById('btn-title-new').onclick = () => {
                const customName = document.getElementById('input-hero-name').value.trim();
                if (customName) this.player.name = customName;
                this.player.setSkin(selectedSkin);
                this.audioManager.init();
                this.audioManager.playSFX('ui_open');
                titleOverlay.classList.add('hidden');
                this.isStarted = true;
                this.uiManager.showToast('Bem-vindo a Oakhaven! Fale com o Aventureiro Kael na praça.');
            };

            btnContinue.onclick = () => {
                this.audioManager.init();
                if (this.saveSystem.loadGame(this)) {
                    titleOverlay.classList.add('hidden');
                    this.isStarted = true;
                    this.uiManager.showToast('Jogo carregado com sucesso!');
                }
            };
        }

        useQuickPotion(itemId) {
            const res = this.inventorySystem.useItem(itemId, this.player, this.equipmentSystem);
            if (res.ok) {
                this.audioManager.playSFX('potion');
                this.combatSystem.spawnFloatingText(
                    this.player.pos.x,
                    this.player.pos.y + 2.2,
                    this.player.pos.z,
                    itemId === 'potion_red' ? '+65 HP' : '+35 SP',
                    itemId === 'potion_red' ? '#7ae582' : '#64dfdf',
                    false
                );
            } else if (res.reason) {
                this.uiManager.showToast(res.reason);
            } else {
                this.uiManager.showToast('Você não possui mais desta poção!');
            }
        }

        _bindInputs() {
            window.addEventListener('resize', () => {
                this.camera.aspect = window.innerWidth / window.innerHeight;
                this.camera.updateProjectionMatrix();
                this.renderer.setSize(window.innerWidth, window.innerHeight);
            });

            window.addEventListener('keydown', (e) => {
                this.keys[e.code] = true;
                if (!this.isStarted) return;

                if (e.code === 'Escape') {
                    if (this.dialogueSystem.isOpen) {
                        this.dialogueSystem.close();
                    } else if (this.uiManager.activeModal) {
                        this.uiManager.closeAllModals();
                    } else {
                        this.uiManager.toggleModal('pause');
                    }
                    return;
                }

                if (e.code === 'KeyI') {
                    this.uiManager.toggleModal('inventory');
                    return;
                }
                if (e.code === 'KeyC') {
                    this.uiManager.toggleModal('stats');
                    return;
                }
                if (e.code === 'KeyQ') {
                    this.uiManager.toggleModal('quests');
                    return;
                }
                if (e.code === 'Digit1') {
                    this.useQuickPotion('potion_red');
                    return;
                }
                if (e.code === 'Digit2') {
                    this.useQuickPotion('potion_blue');
                    return;
                }

                if (e.code === 'KeyE') {
                    if (this.dialogueSystem.isOpen) {
                        this.dialogueSystem.advance();
                    } else if (!this.uiManager.isAnyModalOpen()) {
                        const npc = this.npcSystem.findNearestNPC(this.player.pos, 3.4);
                        if (npc) this.npcSystem.interactWith(npc, this);
                    }
                    return;
                }

                if (e.code === 'Space') {
                    e.preventDefault();
                    if (this.dialogueSystem.isOpen) {
                        this.dialogueSystem.advance();
                    } else if (!this.uiManager.isAnyModalOpen()) {
                        const nearNPC = this.npcSystem.findNearestNPC(this.player.pos, 2.4);
                        if (nearNPC && !this._isMoving()) {
                            this.npcSystem.interactWith(nearNPC, this);
                        } else if (this.player.triggerDodge()) {
                            this.audioManager.playSFX('step');
                        }
                    }
                }
            });

            window.addEventListener('keyup', (e) => {
                this.keys[e.code] = false;
            });

            const raycaster = new THREE.Raycaster();
            const mouseNDC = new THREE.Vector2();
            const groundPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
            const hitPoint = new THREE.Vector3();

            this.canvas.addEventListener('mousedown', (e) => {
                if (e.button !== 0 || !this.isStarted || this.uiManager.isAnyModalOpen()) return;
                this.audioManager.init();

                mouseNDC.x = (e.clientX / window.innerWidth) * 2 - 1;
                mouseNDC.y = -(e.clientY / window.innerHeight) * 2 + 1;
                groundPlane.constant = -this.player.pos.y;
                raycaster.setFromCamera(mouseNDC, this.camera);

                if (raycaster.ray.intersectPlane(groundPlane, hitPoint)) {
                    const dx = hitPoint.x - this.player.pos.x;
                    const dz = hitPoint.z - this.player.pos.z;
                    if (Math.hypot(dx, dz) > 0.2) {
                        this.player.animator.facingAngle = Math.atan2(dx, dz);
                    }
                }

                this.combatSystem.playerBasicAttack(
                    this.player,
                    this.enemyAI,
                    this.questSystem,
                    this.expSystem,
                    this.inventorySystem,
                    this.cameraController,
                    this.audioManager,
                    this.uiManager
                );
            });
        }

        _isMoving() {
            return Boolean(
                this.keys['KeyW'] || this.keys['KeyS'] || this.keys['KeyA'] || this.keys['KeyD'] ||
                this.keys['ArrowUp'] || this.keys['ArrowDown'] || this.keys['ArrowLeft'] || this.keys['ArrowRight']
            );
        }

        _loop(now) {
            requestAnimationFrame((t) => this._loop(t));
            const dt = Math.min(0.05, (now - this.lastTime) / 1000);
            this.lastTime = now;
            this.elapsedTime += dt;

            if (this.isStarted && !this.uiManager.isAnyModalOpen()) {
                if (this.keys['KeyZ']) this.cameraController.rotateYaw(-1.6 * dt);
                if (this.keys['KeyX']) this.cameraController.rotateYaw(1.6 * dt);
            }

            const uiLocked = !this.isStarted || this.uiManager.isAnyModalOpen();

            this.player.update(dt, this.keys, this.cameraController.yaw, this.audioManager, uiLocked);
            this.worldManager.update(dt, this.elapsedTime, this.player.pos);
            this.npcSystem.update(dt, this.elapsedTime, this.cameraController.yaw, this.dialogueSystem.isOpen);

            if (this.isStarted && !this.uiManager.isAnyModalOpen()) {
                this.enemyAI.update(dt, this.cameraController.yaw, this.player, this.combatSystem, this.audioManager);
                this.combatSystem.update(dt, this.player, this.audioManager);
                this.audioManager.setRegion(this.worldManager.currentRegion);
                this.audioManager.update(dt);
            }

            this.cameraController.update(dt, this.player.pos, this.worldManager.occludables);

            if (this.isStarted) {
                this.uiManager.update(dt);
            }

            this.renderer.render(this.scene, this.camera);
        }
    }

    window.addEventListener('DOMContentLoaded', () => {
        if (!window.THREE) {
            document.body.innerHTML = '<div style="padding:32px;color:#ffd166;font-family:sans-serif;">Não foi possível carregar Three.js. Verifique sua conexão com a internet para carregar a biblioteca WebGL.</div>';
            return;
        }
        window.gameInstance = new GameEngine();
    });
    </script>
</body>

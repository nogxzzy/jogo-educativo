    class InventorySystem {
        constructor(maxSlots = 20) {
            this.maxSlots = maxSlots;
            this.items = [];
            this.gold = 120;
        }

        static getDatabase() {
            return ITEM_DATABASE;
        }

        createItem(itemId) {
            const template = ITEM_DATABASE[itemId];
            return template ? JSON.parse(JSON.stringify(template)) : null;
        }

        addItem(itemOrId, qty = 1) {
            const item = typeof itemOrId === 'string' ? this.createItem(itemOrId) : itemOrId;
            if (!item) return false;

            if (item.stackable) {
                const existing = this.items.find(i => i.id === item.id);
                if (existing) {
                    existing.qty += qty;
                    return true;
                }
            }

            if (this.items.length >= this.maxSlots) return false;
            this.items.push({ ...item, qty });
            return true;
        }

        removeItem(itemId, qty = 1) {
            const idx = this.items.findIndex(i => i.id === itemId);
            if (idx === -1) return false;
            this.items[idx].qty -= qty;
            if (this.items[idx].qty <= 0) {
                this.items.splice(idx, 1);
            }
            return true;
        }

        getCount(itemId) {
            const found = this.items.find(i => i.id === itemId);
            return found ? found.qty : 0;
        }

        useItem(itemId, player, equipmentSystem) {
            const entry = this.items.find(i => i.id === itemId);
            if (!entry) return { ok: false };

            if (entry.type === 'consumable') {
                let used = false;
                if (entry.healHp && player.hp < player.maxHp) {
                    player.hp = Math.min(player.maxHp, player.hp + entry.healHp);
                    used = true;
                }
                if (entry.healSp && player.sp < player.maxSp) {
                    player.sp = Math.min(player.maxSp, player.sp + entry.healSp);
                    used = true;
                }
                if (used) {
                    this.removeItem(itemId, 1);
                    return { ok: true, kind: 'potion', item: entry };
                }
                return { ok: false, reason: 'Vida/Mana já estão no máximo!' };
            }

            if (entry.type === 'equipment') {
                const equipped = equipmentSystem.equip(entry, this);
                return { ok: equipped, kind: 'equip', item: entry };
            }

            return { ok: false };
        }

        serialize() {
            return {
                gold: this.gold,
                items: JSON.parse(JSON.stringify(this.items))
            };
        }

        deserialize(data) {
            if (!data) return;
            this.gold = data.gold ?? 120;
            this.items = Array.isArray(data.items) ? data.items : [];
        }
    }


<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crônicas de Oakhaven — RPG 2.5D Fantasia Medieval</title>
    <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"
            onerror="this.onerror=null;this.src='https://unpkg.com/three@0.160.0/build/three.min.js';"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #14110e;
            color: #f3ead8;
        }

        #game-canvas {
            display: block;
            width: 100vw;
            height: 100vh;
        }

        .hidden {
            display: none !important;
        }

        /* Painéis ornamentados estilo RPG Medieval / Ragnarok Online */
        .ro-panel {
            background: linear-gradient(180deg, rgba(44, 33, 24, 0.96) 0%, rgba(26, 19, 14, 0.97) 100%);
            border: 2px solid #c89d54;
            border-radius: 8px;
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.65), inset 0 0 0 1px rgba(255, 232, 180, 0.18);
            padding: 14px;
        }

        .ro-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(200, 157, 84, 0.4);
            padding-bottom: 8px;
            margin-bottom: 12px;
        }

        .ro-panel-header h2 {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 1.15rem;
            color: #f5cb5c;
            letter-spacing: 0.5px;
        }

        .ro-btn {
            background: linear-gradient(180deg, #59412b 0%, #3b291a 100%);
            color: #f3ead8;
            border: 1px solid #c89d54;
            border-radius: 5px;
            padding: 8px 14px;
            font-weight: 600;
            font-size: 0.88rem;
            cursor: pointer;
            transition: transform 0.1s ease, filter 0.15s ease;
        }

        .ro-btn:hover:not(:disabled) {
            filter: brightness(1.18);
            transform: translateY(-1px);
        }

        .ro-btn:active:not(:disabled) {
            transform: translateY(1px);
        }

        .ro-btn:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

        .ro-btn.primary {
            background: linear-gradient(180deg, #b87d28 0%, #7d5014 100%);
            color: #fff9eb;
            border-color: #ffd166;
        }

        .ro-btn.small {
            padding: 5px 10px;
            font-size: 0.8rem;
        }

        /* HUD Superior Esquerdo */
        #hud-top-left {
            position: fixed;
            top: 14px;
            left: 14px;
            display: flex;
            gap: 12px;
            align-items: center;
            width: 310px;
            z-index: 10;
            padding: 10px 12px;
        }

        #hud-portrait {
            width: 62px;
            height: 62px;
            border-radius: 6px;
            border: 2px solid #d4a235;
            background: #1b140e;
            image-rendering: pixelated;
        }

        .hud-bars {
            flex: 1;
        }

        .hud-name-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.9rem;
            font-weight: 700;
            color: #f5cb5c;
            margin-bottom: 5px;
        }

        .bar-wrap {
            position: relative;
            height: 15px;
            background: #140f0b;
            border: 1px solid #6e5434;
            border-radius: 4px;
            overflow: hidden;
            margin-bottom: 4px;
        }

        .bar-wrap.exp {
            height: 8px;
            margin-bottom: 0;
        }

        .bar-fill {
            height: 100%;
            transition: width 0.15s ease;
        }

        .bar-fill.hp { background: linear-gradient(90deg, #b52b2d, #e6484b); }
        .bar-fill.sp { background: linear-gradient(90deg, #2457a6, #4287f5); }
        .bar-fill.exp { background: linear-gradient(90deg, #c48f21, #f5cb5c); }

        .bar-wrap span {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.72rem;
            font-weight: 700;
            text-shadow: 1px 1px 2px #000;
        }

        /* HUD Superior Direito (Minimapa + Missão Ativa) */
        #hud-top-right {
            position: fixed;
            top: 14px;
            right: 14px;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 8px;
            z-index: 10;
        }

        .minimap-box {
            padding: 8px;
            text-align: center;
        }

        #hud-region-name {
            font-family: Georgia, serif;
            font-size: 0.82rem;
            color: #f5cb5c;
            margin-bottom: 5px;
        }

        #minimap-canvas {
            border: 1px solid #c89d54;
            border-radius: 4px;
            display: block;
        }

        #hud-quest-tracker {
            width: 240px;
            padding: 9px 12px;
            font-size: 0.82rem;
        }

        .tracker-title {
            color: #f5cb5c;
            font-weight: 700;
            margin-bottom: 3px;
        }

        /* Barra de Vida do Chefe */
        #boss-hud-bar {
            position: fixed;
            top: 16px;
            left: 50%;
            transform: translateX(-50%);
            width: min(460px, 60vw);
            z-index: 12;
            text-align: center;
            padding: 8px 14px;
        }

        #boss-name-label {
            font-family: Georgia, serif;
            color: #ff7575;
            font-weight: 700;
            margin-bottom: 5px;
        }

        /* Barra Rápida Inferior */
        #hud-bottom-bar {
            position: fixed;
            bottom: 14px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 8px;
            align-items: center;
            z-index: 10;
            padding: 8px 12px;
        }

        .quick-btn {
            position: relative;
            background: #241a12;
            border: 1px solid #c89d54;
            border-radius: 6px;
            color: #f3ead8;
            padding: 7px 11px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
        }

        .quick-btn:hover {
            background: #3b2b1d;
        }

        .badge-count {
            position: absolute;
            top: -6px;
            right: -6px;
            background: #d9383a;
            color: #fff;
            border-radius: 10px;
            padding: 1px 6px;
            font-size: 0.7rem;
            font-weight: 700;
        }

        /* Prompt de interação e Notificações */
        #interact-prompt {
            position: fixed;
            bottom: 84px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(24, 18, 12, 0.92);
            border: 1px solid #f5cb5c;
            color: #ffd166;
            padding: 7px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
            z-index: 11;
        }

        #toast-banner {
            position: fixed;
            top: 96px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(34, 24, 15, 0.95);
            border: 1px solid #f5cb5c;
            color: #fff6db;
            padding: 9px 18px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.9rem;
            z-index: 30;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
        }

        /* Números flutuantes de dano */
        #floating-numbers-layer {
            position: fixed;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: 8;
        }

        .floating-dmg {
            position: absolute;
            top: 0;
            left: 0;
            font-weight: 800;
            font-size: 0.98rem;
            text-shadow: 1px 1px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000;
            will-change: transform, opacity;
        }

        .floating-dmg.crit {
            font-size: 1.22rem;
        }

        /* Janela de Diálogo */
        #dialogue-box {
            position: fixed;
            bottom: 76px;
            left: 50%;
            transform: translateX(-50%);
            width: min(680px, 92vw);
            display: flex;
            gap: 16px;
            z-index: 25;
        }

        #dialogue-portrait {
            width: 92px;
            height: 92px;
            border: 2px solid #c89d54;
            border-radius: 6px;
            image-rendering: pixelated;
            flex-shrink: 0;
        }

        .dialogue-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .dialogue-header {
            display: flex;
            align-items: baseline;
            gap: 10px;
            margin-bottom: 6px;
        }

        #dialogue-npc-name {
            font-family: Georgia, serif;
            font-size: 1.1rem;
            font-weight: 700;
            color: #f5cb5c;
        }

        #dialogue-npc-role {
            font-size: 0.8rem;
            color: #bfb299;
        }

        #dialogue-text {
            font-size: 0.95rem;
            line-height: 1.45;
            margin-bottom: 12px;
        }

        #dialogue-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            justify-content: flex-end;
        }

        /* Modais Centrais */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(10, 8, 6, 0.62);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 40;
        }

        .modal-card {
            width: min(640px, 94vw);
            max-height: 85vh;
            overflow-y: auto;
        }

        /* Inventário & Equipamentos */
        .inv-layout {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: 14px;
        }

        .equip-row {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(18, 13, 9, 0.7);
            border: 1px solid #59442b;
            border-radius: 5px;
            padding: 6px;
            margin-bottom: 6px;
        }

        .equip-row img, .equip-empty-icon {
            width: 34px;
            height: 34px;
            border-radius: 4px;
            border: 1px solid #7c603d;
            background: #17110c;
            image-rendering: pixelated;
        }

        .equip-info {
            flex: 1;
            display: flex;
            flex-direction: column;
            font-size: 0.8rem;
        }

        .equip-slot-tag {
            color: #c89d54;
            font-size: 0.7rem;
            text-transform: uppercase;
        }

        #inventory-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
        }

        .inv-slot {
            position: relative;
            aspect-ratio: 1;
            background: #17110c;
            border: 1px solid #6e5434;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .inv-slot.filled {
            cursor: pointer;
            border-color: #c89d54;
        }

        .inv-slot.filled:hover {
            background: #2c2016;
        }

        .inv-slot img {
            width: 40px;
            height: 40px;
            image-rendering: pixelated;
        }

        .item-qty {
            position: absolute;
            bottom: 3px;
            right: 5px;
            font-size: 0.75rem;
            font-weight: 700;
            color: #ffd166;
        }

        .item-tooltip {
            display: none;
            position: absolute;
            bottom: 108%;
            left: 50%;
            transform: translateX(-50%);
            width: 190px;
            background: #1b140e;
            border: 1px solid #f5cb5c;
            border-radius: 5px;
            padding: 7px;
            font-size: 0.76rem;
            z-index: 50;
            pointer-events: none;
        }

        .inv-slot.filled:hover .item-tooltip {
            display: block;
        }

        /* Atributos */
        .stat-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 7px 10px;
            background: rgba(18, 13, 9, 0.65);
            border-radius: 5px;
            margin-bottom: 6px;
        }

        .stat-row small {
            display: block;
            color: #b8aa91;
            font-size: 0.75rem;
        }

        .stat-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .stat-val {
            font-weight: 700;
            color: #f5cb5c;
            font-size: 1rem;
        }

        #derived-stats-box {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px 16px;
            margin-top: 12px;
            padding-top: 10px;
            border-top: 1px solid rgba(200, 157, 84, 0.35);
            font-size: 0.85rem;
        }

        /* Missões & Loja */
        .quest-card {
            background: rgba(18, 13, 9, 0.75);
            border: 1px solid #6e5434;
            border-radius: 6px;
            padding: 10px 12px;
            margin-bottom: 10px;
        }

        .quest-header, .quest-progress, .quest-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .quest-desc {
            font-size: 0.84rem;
            color: #d6c9b2;
            margin: 6px 0;
        }

        .quest-badge {
            font-size: 0.72rem;
            padding: 2px 8px;
            border-radius: 10px;
            font-weight: 700;
        }

        .badge-active { background: #2b5985; color: #fff; }
        .badge-ready { background: #c48f21; color: #140f0b; }
        .badge-done { background: #2e6b3e; color: #fff; }
        .badge-avail { background: #4a3f35; color: #ddd; }

        .shop-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px;
            background: rgba(18, 13, 9, 0.7);
            border-radius: 5px;
            margin-bottom: 7px;
        }

        .shop-row img {
            width: 38px;
            height: 38px;
            image-rendering: pixelated;
        }

        .shop-item-info {
            flex: 1;
        }

        .shop-item-info small {
            display: block;
            color: #bfb299;
        }

        /* Tela Inicial */
        #title-screen {
            position: fixed;
            inset: 0;
            background: radial-gradient(circle at center, rgba(28, 22, 16, 0.78) 0%, rgba(12, 9, 7, 0.94) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 60;
        }

        .title-card {
            width: min(560px, 92vw);
            text-align: center;
            padding: 24px;
        }

        .title-card h1 {
            font-family: Georgia, serif;
            font-size: 1.9rem;
            color: #f5cb5c;
            margin-bottom: 6px;
        }

        .title-subtitle {
            color: #d6c9b2;
            font-size: 0.92rem;
            margin-bottom: 16px;
        }

        .skin-selector {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin: 14px 0;
        }

        .skin-card {
            background: #1b140e;
            border: 2px solid #59442b;
            border-radius: 8px;
            padding: 10px;
            cursor: pointer;
            transition: border-color 0.15s ease;
        }

        .skin-card.selected {
            border-color: #f5cb5c;
            background: #2b2016;
        }

        .skin-card img {
            width: 72px;
            height: 72px;
            image-rendering: pixelated;
            border-radius: 6px;
            margin-bottom: 6px;
        }

        .skin-card strong {
            display: block;
            font-size: 0.88rem;
            color: #f5cb5c;
        }

        .skin-card small {
            font-size: 0.75rem;
            color: #bfb299;
        }

        #input-hero-name {
            width: 100%;
            padding: 8px 12px;
            margin-bottom: 14px;
            border-radius: 5px;
            border: 1px solid #c89d54;
            background: #17110c;
            color: #f3ead8;
            font-size: 0.95rem;
            text-align: center;
        }

        .title-buttons {
            display: flex;
            gap: 12px;
            justify-content: center;
        }
    </style>
</head>
<body>
    <canvas id="game-canvas"></canvas>
    <div id="floating-numbers-layer"></div>

    <!-- HUD Superior Esquerdo -->
    <div id="hud-top-left" class="ro-panel">
        <img id="hud-portrait" alt="Retrato do Herói">
        <div class="hud-bars">
            <div class="hud-name-row">
                <span id="hud-char-name">Sir Aldren</span>
                <span id="hud-level">Nv. 1</span>
            </div>
            <div class="bar-wrap">
                <div id="hud-hp-bar" class="bar-fill hp" style="width: 100%"></div>
                <span id="hud-hp-text">110 / 110</span>
            </div>
            <div class="bar-wrap">
                <div id="hud-sp-bar" class="bar-fill sp" style="width: 100%"></div>
                <span id="hud-sp-text">40 / 40</span>
            </div>
            <div class="bar-wrap exp">
                <div id="hud-exp-bar" class="bar-fill exp" style="width: 0%"></div>
            </div>
        </div>
    </div>

    <!-- HUD Superior Direito (Minimapa e Missão Ativa) -->
    <div id="hud-top-right">
        <div class="ro-panel minimap-box">
            <div id="hud-region-name">Vilarejo de Oakhaven</div>
            <canvas id="minimap-canvas" width="144" height="144"></canvas>
        </div>
        <div id="hud-quest-tracker" class="ro-panel"></div>
    </div>

    <!-- Barra de Vida do Chefe Final -->
    <div id="boss-hud-bar" class="ro-panel hidden">
        <div id="boss-name-label">Goblin Rei Grakthar</div>
        <div class="bar-wrap">
            <div id="boss-hp-fill" class="bar-fill hp" style="width: 100%"></div>
        </div>
    </div>

    <!-- Barra de Ações Rápidas Inferior -->
    <div id="hud-bottom-bar" class="ro-panel">
        <button id="quick-slot-1" class="quick-btn" title="Usar Poção Vermelha">
            [1] Poção HP <span id="quick-hp-count" class="badge-count">4</span>
        </button>
        <button id="quick-slot-2" class="quick-btn" title="Usar Poção Azul">
            [2] Poção SP <span id="quick-sp-count" class="badge-count">2</span>
        </button>
        <button id="btn-toggle-inv" class="quick-btn">[I] Inventário</button>
        <button id="btn-toggle-stats" class="quick-btn">
            [C] Atributos <span id="stat-point-badge" class="badge-count hidden">+5</span>
        </button>
        <button id="btn-toggle-quests" class="quick-btn">[Q] Missões</button>
        <button id="btn-toggle-menu" class="quick-btn">[ESC] Menu</button>
    </div>

    <div id="interact-prompt" class="hidden">[E] Conversar</div>
    <div id="toast-banner" class="hidden"></div>

    <!-- Janela de Diálogo com NPC -->
    <div id="dialogue-box" class="ro-panel hidden">
        <img id="dialogue-portrait" alt="Retrato NPC">
        <div class="dialogue-body">
            <div>
                <div class="dialogue-header">
                    <span id="dialogue-npc-name">NPC</span>
                    <span id="dialogue-npc-role">Função</span>
                </div>
                <p id="dialogue-text"></p>
            </div>
            <div id="dialogue-actions"></div>
        </div>
    </div>

    <!-- Modal: Inventário e Equipamentos [I] -->
    <div id="modal-inventory" class="modal-overlay hidden">
        <div class="ro-panel modal-card">
            <div class="ro-panel-header">
                <h2>Inventário &amp; Equipamentos</h2>
                <div>
                    <strong id="inv-gold-value" style="color:#ffd166;margin-right:12px;">120 Zeny</strong>
                    <button class="ro-btn small" data-close-modal>Fechar [I]</button>
                </div>
            </div>
            <div class="inv-layout">
                <div>
                    <h4 style="margin-bottom:8px;color:#c89d54;">Equipado</h4>
                    <div id="equip-slots-list"></div>
                </div>
                <div>
                    <h4 style="margin-bottom:8px;color:#c89d54;">Mochila (Clique para usar/equipar)</h4>
                    <div id="inventory-grid"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal: Atributos do Personagem [C] -->
    <div id="modal-stats" class="modal-overlay hidden">
        <div class="ro-panel modal-card">
            <div class="ro-panel-header">
                <h2>Atributos do Personagem</h2>
                <div>
                    <span style="margin-right:12px;">Pontos Disponíveis: <strong id="stat-points-avail" style="color:#ffd166;">5</strong></span>
                    <button class="ro-btn small" data-close-modal>Fechar [C]</button>
                </div>
            </div>
            <div id="base-stats-list"></div>
            <div id="derived-stats-box"></div>
        </div>
    </div>

    <!-- Modal: Painel de Missões [Q] -->
    <div id="modal-quests" class="modal-overlay hidden">
        <div class="ro-panel modal-card">
            <div class="ro-panel-header">
                <h2>Diário de Missões</h2>
                <button class="ro-btn small" data-close-modal>Fechar [Q]</button>
            </div>
            <div id="quest-list-container"></div>
        </div>
    </div>

    <!-- Modal: Loja Medieval -->
    <div id="modal-shop" class="modal-overlay hidden">
        <div class="ro-panel modal-card">
            <div class="ro-panel-header">
                <h2 id="shop-title">Loja</h2>
                <div>
                    <strong id="shop-gold-display" style="color:#ffd166;margin-right:12px;">120 Zeny</strong>
                    <button class="ro-btn small" data-close-modal>Fechar</button>
                </div>
            </div>
            <div id="shop-items-list"></div>
        </div>
    </div>

    <!-- Modal: Menu de Pausa e Salvamento [ESC] -->
    <div id="modal-pause" class="modal-overlay hidden">
        <div class="ro-panel modal-card" style="max-width:400px;text-align:center;">
            <div class="ro-panel-header">
                <h2>Menu do Aventureiro</h2>
                <button class="ro-btn small" data-close-modal>Voltar</button>
            </div>
            <div style="display:flex;flex-direction:column;gap:10px;">
                <button id="btn-save-game" class="ro-btn primary">Salvar Progresso</button>
                <button id="btn-load-game" class="ro-btn">Carregar Último Save</button>
                <button id="btn-toggle-audio" class="ro-btn">Áudio: Ativado</button>
                <p style="font-size:0.78rem;color:#bfb299;margin-top:6px;">
                    Controles: WASD Mover • Clique Esq. Atacar • Espaço Esquivar • E Conversar • I Inventário • C Atributos • Q Missões • Z/X Girar Câmera
                </p>
            </div>
        </div>
    </div>

    <!-- Modal: Derrota -->
    <div id="death-modal" class="modal-overlay hidden">

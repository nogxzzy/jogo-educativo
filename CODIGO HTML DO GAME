                if (dialogueOpen) {
                    npc.animator.setState('idle');
                    npc.animator.update(dt, cameraYaw);
                    continue;
                }

                const distToTarget = Math.hypot(npc.targetPos.x - npc.pos.x, npc.targetPos.z - npc.pos.z);
                if (distToTarget > 0.15) {
                    const dx = npc.targetPos.x - npc.pos.x;
                    const dz = npc.targetPos.z - npc.pos.z;
                    const len = Math.hypot(dx, dz);
                    const step = Math.min(len, 1.55 * dt);
                    npc.pos.x += (dx / len) * step;
                    npc.pos.z += (dz / len) * step;
                    npc.pos.y = this.worldManager.getTerrainHeight(npc.pos.x, npc.pos.z);
                    npc.animator.facingAngle = Math.atan2(dx, dz);
                    npc.animator.setState('walk');
                } else {
                    npc.animator.setState('idle');
                    npc.waitTimer -= dt;
                    if (npc.waitTimer <= 0) {
                        npc.waitTimer = 2.5 + Math.random() * 3.5;
                        const angle = Math.random() * Math.PI * 2;
                        const r = Math.random() * npc.patrolRadius;
                        npc.targetPos.set(
                            npc.homeX + Math.cos(angle) * r,
                            0,
                            npc.homeZ + Math.sin(angle) * r
                        );
                    }
                }

                npc.animator.setPosition(npc.pos.x, npc.pos.y, npc.pos.z);
                npc.animator.update(dt, cameraYaw);
            }
        }
    }


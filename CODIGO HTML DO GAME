            this._createTorchPost(-8.5, -72);
            this._createTorchPost(8.5, -72);
        }

        resolveCollisions(pos, entityRadius = 0.55) {
            pos.x = Math.max(-34, Math.min(34, pos.x));
            pos.z = Math.max(-88, Math.min(64, pos.z));

            for (let i = 0; i < this.colliders.length; i++) {
                const c = this.colliders[i];
                const dx = pos.x - c.x;
                const dz = pos.z - c.z;
                const minDist = entityRadius + c.radius;
                const distSq = dx * dx + dz * dz;
                if (distSq < minDist * minDist && distSq > 0.0001) {
                    const dist = Math.sqrt(distSq);
                    const push = (minDist - dist);
                    pos.x += (dx / dist) * push;
                    pos.z += (dz / dist) * push;
                }
            }
        }

        update(dt, time, playerPos) {
            if (this.waterMesh) {
                this.waterMesh.position.y = -0.35 + Math.sin(time * 2.1) * 0.04;
            }

            for (const t of this.torchLights) {
                const flicker = 1.25 + Math.sin(time * 11 + t.phase) * 0.22;
                t.light.intensity = flicker;
                const s = 0.9 + Math.sin(time * 14 + t.phase) * 0.18;
                t.flame.scale.set(s, s * 1.2, s);
            }

            for (const f of this.foliageClusters) {
                f.mesh.rotation.z = Math.sin(time * 1.3 + f.phase) * 0.025;
            }

            this.currentRegion = this.getRegionAt(playerPos.x, playerPos.z);
        }
    }

    /* ==========================================================================
       4. CameraController — Perspectiva oblíqua estilo Ragnarok + oclusão
       ========================================================================== */
    class CameraController {
        constructor(camera, domElement) {
            this.camera = camera;
            this.yaw = 0;
            this.pitch = 0.76;
            this.distance = 17.5;
            this.minDistance = 11.5;
            this.maxDistance = 26.0;

            this.currentLookAt = new THREE.Vector3(0, 1, 38);
            this.shakeTime = 0;
            this.shakeIntensity = 0;
            this.fadedObjects = new Set();

            domElement.addEventListener('wheel', (e) => {
                e.preventDefault();
                this.distance = Math.max(
                    this.minDistance,
                    Math.min(this.maxDistance, this.distance + e.deltaY * 0.01)
                );
            }, { passive: false });
        }

        rotateYaw(delta) {
            this.yaw += delta;
        }

        triggerShake(intensity = 0.35, duration = 0.22) {
            this.shakeIntensity = intensity;
            this.shakeTime = duration;
        }

        update(dt, targetPos, occludables) {
            const desiredLookAt = new THREE.Vector3(targetPos.x, targetPos.y + 1.1, targetPos.z);
            this.currentLookAt.lerp(desiredLookAt, Math.min(1, dt * 8.5));

            const horizDist = Math.cos(this.pitch) * this.distance;
            const vertDist = Math.sin(this.pitch) * this.distance;

            const camX = this.currentLookAt.x + Math.sin(this.yaw) * horizDist;
            const camZ = this.currentLookAt.z + Math.cos(this.yaw) * horizDist;
            const camY = this.currentLookAt.y + vertDist;

            this.camera.position.set(camX, camY, camZ);

            if (this.shakeTime > 0) {
                this.shakeTime -= dt;
                this.camera.position.x += (Math.random() - 0.5) * this.shakeIntensity;
                this.camera.position.y += (Math.random() - 0.5) * this.shakeIntensity;
            }

            this.camera.lookAt(this.currentLookAt);
            this._handleOcclusion(occludables);
        }

        _handleOcclusion(occludables) {
            for (const obj of this.fadedObjects) {
                if (obj.material) {
                    obj.material.transparent = false;
                    obj.material.opacity = 1.0;
                }
            }
            this.fadedObjects.clear();

            if (!occludables) return;

            const camPos = this.camera.position;
            const target = this.currentLookAt;
            const segX = target.x - camPos.x;
            const segZ = target.z - camPos.z;
            const segLenSq = segX * segX + segZ * segZ;
            if (segLenSq < 0.01) return;

            const worldPos = new THREE.Vector3();
            for (let i = 0; i < occludables.length; i++) {
                const obj = occludables[i];
                obj.getWorldPosition(worldPos);
                if (worldPos.z < target.z - 0.5) continue;

                const t = Math.max(0, Math.min(1,
                    ((worldPos.x - camPos.x) * segX + (worldPos.z - camPos.z) * segZ) / segLenSq
                ));
                const projX = camPos.x + t * segX;
                const projZ = camPos.z + t * segZ;
                const distSq = (worldPos.x - projX) ** 2 + (worldPos.z - projZ) ** 2;

                if (distSq < 9.5 && obj.material) {
                    obj.material.transparent = true;
                    obj.material.opacity = 0.34;
                    this.fadedObjects.add(obj);
                }
            }
        }
    }

    /* ==========================================================================
       5. ExperienceSystem — Níveis, EXP e 6 atributos (FOR, AGI, VIT, INT, DES, SOR)
       ========================================================================== */
    class ExperienceSystem {
        constructor() {
            this.level = 1;
            this.exp = 0;
            this.nextExp = 100;
            this.statPoints = 5;

            this.stats = {
                str: 5,
                agi: 5,
                vit: 5,
                int: 3,
                dex: 5,
                luk: 3
            };

            this.onLevelUp = null;
        }

        gainExp(amount) {
            this.exp += amount;
            let leveled = false;
            while (this.exp >= this.nextExp) {
                this.exp -= this.nextExp;
                this.level += 1;
                this.statPoints += 4;
                this.nextExp = Math.round(100 * Math.pow(this.level, 1.45));
                leveled = true;
            }
            if (leveled && this.onLevelUp) {
                this.onLevelUp(this.level);
            }
            return leveled;
        }

        allocateStat(statKey) {
            if (this.statPoints <= 0) return false;
            if (!Object.prototype.hasOwnProperty.call(this.stats, statKey)) return false;
            this.stats[statKey] += 1;
            this.statPoints -= 1;
            return true;
        }

        computeDerivedStats(equipBonuses) {
            const s = this.stats;
            const b = equipBonuses || { atk: 0, def: 0, maxHp: 0, maxSp: 0, speed: 0, crit: 0 };

            const maxHp = 110 + (this.level - 1) * 18 + s.vit * 16 + b.maxHp;
            const maxSp = 40 + (this.level - 1) * 6 + s.int * 8 + b.maxSp;
            const atk = 12 + s.str * 3 + Math.floor(s.dex * 0.8) + b.atk;
            const def = 4 + Math.floor(s.vit * 1.4) + Math.floor(s.agi * 0.4) + b.def;
            const critChance = Math.min(0.65, 0.05 + s.luk * 0.018 + s.dex * 0.005 + b.crit);
            const attackCooldown = Math.max(0.24, 0.52 - s.agi * 0.012);
            const moveSpeed = 6.4 + Math.min(2.2, s.agi * 0.06) + b.speed;

            return { maxHp, maxSp, atk, def, critChance, attackCooldown, moveSpeed };
        }

        serialize() {
            return {
                level: this.level,
                exp: this.exp,
                nextExp: this.nextExp,
                statPoints: this.statPoints,
                stats: { ...this.stats }
            };
        }

        deserialize(data) {
            if (!data) return;
            this.level = data.level || 1;
            this.exp = data.exp || 0;
            this.nextExp = data.nextExp || 100;
            this.statPoints = data.statPoints ?? 5;
            if (data.stats) Object.assign(this.stats, data.stats);
        }
    }

    /* ==========================================================================
       6. EquipmentSystem — Espadas, Escudos, Armaduras, Botas e Acessórios
       ========================================================================== */
    class EquipmentSystem {
        constructor() {
            this.slots = {
                weapon: null,
                shield: null,
                armor: null,
                boots: null,
                accessory: null
            };
        }

        equip(item, inventorySystem) {
            if (!item || !item.slot || !Object.prototype.hasOwnProperty.call(this.slots, item.slot)) {
                return false;
            }
            const previous = this.slots[item.slot];
            this.slots[item.slot] = item;
            inventorySystem.removeItem(item.id, 1);
            if (previous) {
                inventorySystem.addItem(previous, 1);
            }
            return true;
        }

        unequip(slotName, inventorySystem) {
            const current = this.slots[slotName];
            if (!current) return false;
            if (!inventorySystem.addItem(current, 1)) return false;
            this.slots[slotName] = null;
            return true;
        }

        getTotalBonuses() {
            const totals = { atk: 0, def: 0, maxHp: 0, maxSp: 0, speed: 0, crit: 0 };
            for (const slotKey of Object.keys(this.slots)) {
                const item = this.slots[slotKey];
                if (!item || !item.bonuses) continue;
                totals.atk += item.bonuses.atk || 0;
                totals.def += item.bonuses.def || 0;
                totals.maxHp += item.bonuses.maxHp || 0;
                totals.maxSp += item.bonuses.maxSp || 0;
                totals.speed += item.bonuses.speed || 0;
                totals.crit += item.bonuses.crit || 0;
            }
            return totals;
        }

        serialize() {
            return JSON.parse(JSON.stringify(this.slots));
        }

        deserialize(data) {
            if (!data) return;
            for (const key of Object.keys(this.slots)) {
                this.slots[key] = data[key] || null;
            }
        }
    }


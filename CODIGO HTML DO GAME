                    hairColor: '#4a3222',
                    hairDark: '#2c1c12',
                    armorMain: '#8c9ba8',
                    armorTrim: '#c5d1db',
                    pauldronColor: '#a8b7c4',
                    gloveColor: '#52606d',
                    pantsColor: '#36414d',
                    bootColor: '#4a3222',
                    cloakColor: '#8f2424',
                    cloakDark: '#5e1414',
                    emblem: 'crest',
                    weapon: 'sword',
                    hasShield: true
                },
                guardian: {

            if (q && q.status === 'available') {
                q.status = 'active';
                if (this.onQuestUpdate) this.onQuestUpdate(q, 'accepted');
                return true;
            }
            return false;
        }

        notifyTalk(npcId) {
            for (const q of this.quests) {
                if (q.status === 'active' && q.type === 'talk' && q.target === npcId) {
                    q.current = Math.min(q.required, q.current + 1);
                    if (q.current >= q.required) q.status = 'ready';
                    if (this.onQuestUpdate) this.onQuestUpdate(q, 'progress');
                }
            }
        }

        notifyKill(enemyKind) {
            for (const q of this.quests) {
                if (q.status === 'active' && q.type === 'kill' && q.target === enemyKind) {
                    q.current = Math.min(q.required, q.current + 1);
                    if (q.current >= q.required) q.status = 'ready';
                    if (this.onQuestUpdate) this.onQuestUpdate(q, 'progress');
                }
            }
        }

        claimReward(id, expSystem, inventorySystem) {
            const q = this.getQuest(id);
            if (!q || q.status !== 'ready') return false;

            q.status = 'completed';
            expSystem.gainExp(q.rewards.exp);
            inventorySystem.gold += q.rewards.gold;
            if (q.rewards.itemId) {
                inventorySystem.addItem(q.rewards.itemId, q.rewards.itemQty || 1);
            }

            if (id === 'q1_elder') {
                const q2 = this.getQuest('q2_goblins');
                if (q2 && q2.status === 'available') q2.status = 'active';
            } else if (id === 'q2_goblins') {
                const q3 = this.getQuest('q3_warrior');
                if (q3 && q3.status === 'available') q3.status = 'active';
            } else if (id === 'q3_warrior') {
                const q4 = this.getQuest('q4_king');
                if (q4 && q4.status === 'available') q4.status = 'active';
            }

            if (this.onQuestUpdate) this.onQuestUpdate(q, 'completed');
            return true;
        }

        serialize() {
            return this.quests.map(q => ({
                id: q.id,
                current: q.current,
                status: q.status
            }));
        }

        deserialize(data) {
            if (!Array.isArray(data)) return;
            for (const saved of data) {
                const q = this.getQuest(saved.id);
                if (q) {
                    q.current = saved.current ?? 0;
                    q.status = saved.status || q.status;
                }
            }
        }
    }


            return presets[type] || presets.knight;
        }

        getItemIconURL(iconType) {
            if (this.iconCache.has(iconType)) return this.iconCache.get(iconType);

            const canvas = document.createElement('canvas');
            canvas.width = 48;
            canvas.height = 48;
            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingEnabled = false;
            ctx.clearRect(0, 0, 48, 48);

            if (iconType === 'potion_hp') {
                ctx.fillStyle = '#2b1d14';
                ctx.fillRect(20, 6, 8, 6);
                ctx.fillStyle = '#c9b8a3';
                ctx.fillRect(18, 12, 12, 4);
                ctx.fillStyle = '#d9383a';
                ctx.beginPath();
                ctx.arc(24, 29, 13, 0, Math.PI * 2);
                ctx.fill();
                ctx.strokeStyle = '#4a1214';
                ctx.lineWidth = 2;
                ctx.stroke();
                ctx.fillStyle = '#ff8a8c';
                ctx.fillRect(18, 22, 4, 6);
            } else if (iconType === 'potion_sp') {
                ctx.fillStyle = '#2b1d14';
                ctx.fillRect(20, 6, 8, 6);
                ctx.fillStyle = '#3876d9';
                ctx.beginPath();
                ctx.arc(24, 29, 13, 0, Math.PI * 2);
                ctx.fill();
                ctx.strokeStyle = '#12294a';
                ctx.lineWidth = 2;
                ctx.stroke();
                ctx.fillStyle = '#94c5ff';
                ctx.fillRect(18, 22, 4, 6);
            } else if (iconType.startsWith('sword')) {
                const bladeColor = iconType === 'sword_royal' ? '#f5cb5c' : iconType === 'sword_steel' ? '#dce6f2' : '#9aa5b1';
                ctx.save();
                ctx.translate(24, 24);
                ctx.rotate(-Math.PI / 4);
                ctx.fillStyle = bladeColor;
                ctx.fillRect(-3, -20, 6, 28);
                ctx.strokeStyle = '#1f2933';
                ctx.lineWidth = 2;
                ctx.strokeRect(-3, -20, 6, 28);
                ctx.fillStyle = '#d4a235';
                ctx.fillRect(-9, 8, 18, 4);
                ctx.fillStyle = '#5c3a21';
                ctx.fillRect(-2, 12, 4, 8);
                ctx.restore();
            } else if (iconType.startsWith('shield')) {
                ctx.fillStyle = iconType === 'shield_iron' ? '#7b8794' : '#8c5a32';
                ctx.beginPath();
                ctx.moveTo(12, 10);
                ctx.lineTo(36, 10);
                ctx.lineTo(34, 28);
                ctx.lineTo(24, 40);
                ctx.lineTo(14, 28);
                ctx.closePath();
                ctx.fill();
                ctx.strokeStyle = '#d4a235';
                ctx.lineWidth = 3;
                ctx.stroke();
            } else if (iconType.startsWith('armor')) {
                ctx.fillStyle = iconType === 'armor_knight' ? '#8c9ba8' : '#7c5332';
                ctx.fillRect(12, 12, 24, 24);
                ctx.strokeStyle = '#1f2933';
                ctx.lineWidth = 2;
                ctx.strokeRect(12, 12, 24, 24);
                ctx.fillStyle = '#d4a235';
                ctx.fillRect(21, 14, 6, 18);
            } else if (iconType.startsWith('boots')) {
                ctx.fillStyle = '#6e472b';
                ctx.fillRect(11, 16, 10, 20);
                ctx.fillRect(25, 16, 10, 20);
                ctx.fillStyle = '#d4a235';
                ctx.fillRect(11, 16, 10, 4);
                ctx.fillRect(25, 16, 10, 4);
            } else if (iconType.startsWith('ring')) {
                ctx.strokeStyle = '#f2c138';
                ctx.lineWidth = 4;
                ctx.beginPath();
                ctx.arc(24, 26, 10, 0, Math.PI * 2);
                ctx.stroke();
                ctx.fillStyle = '#38b000';
                ctx.fillRect(21, 12, 6, 6);
            } else {
                ctx.fillStyle = '#f2c138';
                ctx.fillRect(10, 18, 28, 14);
                ctx.fillStyle = '#d9383a';
                ctx.fillRect(21, 22, 6, 6);
            }

            const url = canvas.toDataURL();
            this.iconCache.set(iconType, url);
            return url;
        }
    }

    /* ==========================================================================
       2. SpriteAnimator — Billboards 2D integrados ao mundo 3D
       ========================================================================== */
    class SpriteAnimator {
        constructor(scene, texture, options = {}) {
            this.scene = scene;
            this.cols = 8;
            this.rows = 4;

            this.texture = texture.clone();
            this.texture.needsUpdate = true;
            this.texture.repeat.set(1 / this.cols, 1 / this.rows);

            const width = options.width || 2.5;
            const height = options.height || 2.5;

            const geometry = new THREE.PlaneGeometry(width, height);
            geometry.translate(0, height * 0.48, 0);

            this.material = new THREE.MeshStandardMaterial({
                map: this.texture,
                transparent: true,
                alphaTest: 0.35,
                roughness: 0.85,
                metalness: 0.05,
                side: THREE.DoubleSide
            });

            this.mesh = new THREE.Mesh(geometry, this.material);
            this.mesh.castShadow = true;
            this.mesh.receiveShadow = false;
            this.scene.add(this.mesh);

            this.state = 'idle';
            this.facingAngle = 0;
            this.timer = Math.random() * 2;
            this.stateTimer = 0;
            this.frameCol = 0;
            this.dirRow = 0;

            this._updateUV();
        }

        setState(newState, duration = 0) {
            if (this.state === 'dead' && newState !== 'idle') return;
            if (this.state !== newState) {
                this.state = newState;
                this.timer = 0;
                this.stateTimer = duration;
            } else if (duration > 0) {
                this.stateTimer = duration;
            }
        }

        setPosition(x, y, z) {
            this.mesh.position.set(x, y, z);
        }

        update(dt, cameraYaw) {
            this.timer += dt;

            if (this.stateTimer > 0) {
                this.stateTimer -= dt;
                if (this.stateTimer <= 0 && this.state !== 'dead') {
                    this.state = 'idle';
                }
            }

            this.mesh.rotation.set(0, cameraYaw, 0);

            let relAngle = this.facingAngle - cameraYaw;
            while (relAngle > Math.PI) relAngle -= Math.PI * 2;
            while (relAngle < -Math.PI) relAngle += Math.PI * 2;

            if (relAngle >= -Math.PI * 0.25 && relAngle < Math.PI * 0.25) {
                this.dirRow = 0;
            } else if (relAngle >= Math.PI * 0.25 && relAngle < Math.PI * 0.75) {
                this.dirRow = 2;
            } else if (relAngle >= -Math.PI * 0.75 && relAngle < -Math.PI * 0.25) {
                this.dirRow = 1;
            } else {
                this.dirRow = 3;
            }

            if (this.state === 'idle') {
                this.frameCol = Math.floor(this.timer * 2.4) % 2;
                this.mesh.rotation.z = 0;
            } else if (this.state === 'walk') {
                this.frameCol = 2 + (Math.floor(this.timer * 8.5) % 4);
                this.mesh.rotation.z = 0;
            } else if (this.state === 'attack') {
                this.frameCol = 6;
                this.mesh.rotation.z = 0;
            } else if (this.state === 'hurt') {
                this.frameCol = 7;
            } else if (this.state === 'dead') {
                this.frameCol = 7;
                this.mesh.rotation.z = Math.min(Math.PI * 0.45, this.timer * 4.5);
            }

            this._updateUV();
        }

        _updateUV() {
            const u = this.frameCol / this.cols;
            const v = 1 - (this.dirRow + 1) / this.rows;
            this.texture.offset.set(u, v);
        }

        dispose() {
            this.scene.remove(this.mesh);
            this.mesh.geometry.dispose();
            this.material.dispose();
            this.texture.dispose();
        }
    }

    /* ==========================================================================
       3. WorldManager — Terreno 3D orgânico, Vilarejo, Floresta e Santuário
       ========================================================================== */
    class WorldManager {
        constructor(scene) {
            this.scene = scene;
            this.colliders = [];
            this.occludables = [];
            this.torchLights = [];
            this.foliageClusters = [];
            this.waterMesh = null;
            this.currentRegion = 'village';
            this.regionNames = {
                village: 'Vilarejo de Oakhaven',
                forest: 'Floresta dos Goblins',
                boss: 'Santuário do Goblin Rei'
            };
        }

        buildWorld() {
            this._setupLightingAndAtmosphere();
            this._buildOrganicTerrain();
            this._buildRiverAndBridge();
            this._buildVillage();
            this._buildGoblinForest();
            this._buildBossSanctuary();
        }

        getTerrainHeight(x, z) {
            const distVillage = Math.hypot(x - 0, z - 38);
            if (distVillage < 24) return 0.15;

            const riverCurveZ = 10.5 + Math.sin(x * 0.08) * 2.5;
            const distRiver = Math.abs(z - riverCurveZ);
            if (distRiver < 3.6 && Math.abs(x) < 3.6) return 0.45;
            if (distRiver < 4.2) {
                const t = 1 - distRiver / 4.2;
                return -1.15 * t * t;
            }

            if (z < -52) {
                const ramp = Math.min(1, (-52 - z) / 14);
                return ramp * 1.4 + Math.sin(x * 0.12) * 0.12;
            }

            const roadDist = Math.abs(x - Math.sin(z * 0.05) * 4.5);
            const roadFlatten = Math.min(1, Math.max(0, (roadDist - 2.5) / 8));
            return (Math.sin(x * 0.07) * Math.cos(z * 0.07) * 1.35 +
                    Math.sin(x * 0.16 + z * 0.11) * 0.45) * roadFlatten;
        }

        getRegionAt(x, z) {
            if (z > 12) return 'village';
            if (z > -48) return 'forest';
            return 'boss';
        }

        _setupLightingAndAtmosphere() {
            this.scene.background = new THREE.Color(0x88b4c8);
            this.scene.fog = new THREE.FogExp2(0x9ec4b8, 0.0085);

            const hemi = new THREE.HemisphereLight(0xfff5e4, 0x3b5932, 0.78);
            hemi.position.set(0, 60, 0);
            this.scene.add(hemi);

            this.sunLight = new THREE.DirectionalLight(0xfff0d4, 1.35);
            this.sunLight.position.set(42, 68, 45);
            this.sunLight.castShadow = true;
            this.sunLight.shadow.mapSize.width = 2048;
            this.sunLight.shadow.mapSize.height = 2048;
            this.sunLight.shadow.camera.near = 10;
            this.sunLight.shadow.camera.far = 210;
            const d = 85;
            this.sunLight.shadow.camera.left = -d;
            this.sunLight.shadow.camera.right = d;
            this.sunLight.shadow.camera.top = d;
            this.sunLight.shadow.camera.bottom = -d;
            this.sunLight.shadow.bias = -0.0005;
            this.scene.add(this.sunLight);
        }

        _createTerrainTexture() {
            const size = 1024;
            const canvas = document.createElement('canvas');
            canvas.width = size;
            canvas.height = size;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = '#4e7c36';
            ctx.fillRect(0, 0, size, size);

            for (let i = 0; i < 6500; i++) {
                const x = Math.random() * size;
                const y = Math.random() * size;
                const r = 2 + Math.random() * 9;
                const colors = ['#436e2c', '#5b8c3e', '#689946', '#3c6127', '#74a34e'];
                ctx.fillStyle = colors[i % colors.length];
                ctx.beginPath();
                ctx.arc(x, y, r, 0, Math.PI * 2);
                ctx.fill();
            }

            for (let i = 0; i < 600; i++) {
                const x = Math.random() * size;
                const y = Math.random() * size;
                ctx.fillStyle = i % 3 === 0 ? '#f7e588' : i % 3 === 1 ? '#ffffff' : '#e88d9c';
                ctx.fillRect(x, y, 2, 2);
            }

            const toPx = (wx, wz) => [
                ((wx + 110) / 220) * size,
                ((wz + 110) / 220) * size
            ];

            // Praça central do Vilarejo
            const [vx, vz] = toPx(0, 38);
            const plazaR = (17 / 220) * size;
            ctx.fillStyle = '#9e9585';
            ctx.beginPath();
            ctx.arc(vx, vz, plazaR, 0, Math.PI * 2);
            ctx.fill();

            for (let i = 0; i < 550; i++) {
                const a = Math.random() * Math.PI * 2;
                const rad = Math.sqrt(Math.random()) * (plazaR - 4);
                const sx = vx + Math.cos(a) * rad;
                const sy = vz + Math.sin(a) * rad;
                ctx.fillStyle = i % 2 === 0 ? '#b2a896' : '#857c6d';
                ctx.fillRect(sx - 2, sy - 2, 5, 4);
            }

            // Estrada principal de terra batida
            ctx.strokeStyle = '#9c7a54';
            ctx.lineCap = 'round';
            ctx.lineWidth = (5.4 / 220) * size;
            ctx.beginPath();
            for (let wz = 64; wz >= -76; wz -= 2) {
                const wx = wz > 12 ? Math.sin((wz - 38) * 0.08) * 2.2 : Math.sin(wz * 0.05) * 4.5;
                const [px, py] = toPx(wx, wz);
                if (wz === 64) ctx.moveTo(px, py);
                else ctx.lineTo(px, py);
            }
            ctx.stroke();

            ctx.strokeStyle = '#b38f66';
            ctx.lineWidth = (2.6 / 220) * size;
            ctx.stroke();

            // Arena de pedra do Goblin Rei
            const [bx, bz] = toPx(0, -72);
            ctx.fillStyle = '#6e6a63';
            ctx.beginPath();
            ctx.arc(bx, bz, (14 / 220) * size, 0, Math.PI * 2);
            ctx.fill();

            const tex = new THREE.CanvasTexture(canvas);
            tex.colorSpace = THREE.SRGBColorSpace;
            tex.anisotropy = 8;
            return tex;
        }

        _buildOrganicTerrain() {
            const geo = new THREE.PlaneGeometry(220, 220, 180, 180);
            geo.rotateX(-Math.PI / 2);

            const pos = geo.attributes.position;
            for (let i = 0; i < pos.count; i++) {
                const x = pos.getX(i);
                const z = pos.getZ(i);
                pos.setY(i, this.getTerrainHeight(x, z));
            }
            geo.computeVertexNormals();

            const mat = new THREE.MeshStandardMaterial({
                map: this._createTerrainTexture(),
                roughness: 0.92,
                metalness: 0.02
            });

            const terrain = new THREE.Mesh(geo, mat);
            terrain.receiveShadow = true;
            this.scene.add(terrain);
        }

        _buildRiverAndBridge() {
            const waterGeo = new THREE.PlaneGeometry(180, 12, 64, 8);
            waterGeo.rotateX(-Math.PI / 2);
            const waterMat = new THREE.MeshStandardMaterial({
                color: 0x2b8cbe,
                emissive: 0x0b3954,
                emissiveIntensity: 0.25,
                roughness: 0.18,
                metalness: 0.35,
                transparent: true,
                opacity: 0.84
            });
            this.waterMesh = new THREE.Mesh(waterGeo, waterMat);
            this.waterMesh.position.set(0, -0.35, 10.5);
            this.scene.add(this.waterMesh);

            const bridgeGroup = new THREE.Group();
            bridgeGroup.position.set(0, 0.48, 10.5);

            const woodMat = new THREE.MeshStandardMaterial({ color: 0x6e472b, roughness: 0.85 });
            const darkWoodMat = new THREE.MeshStandardMaterial({ color: 0x4a2e1b, roughness: 0.9 });

            for (let i = -8; i <= 8; i++) {
                const archY = Math.cos((i / 8) * (Math.PI * 0.45)) * 0.35;
                const plank = new THREE.Mesh(new THREE.BoxGeometry(5.2, 0.22, 0.56), woodMat);
                plank.position.set(0, archY, i * 0.62);
                plank.castShadow = true;
                plank.receiveShadow = true;
                bridgeGroup.add(plank);
            }

            for (const side of [-2.4, 2.4]) {
                for (const pz of [-4.5, -1.5, 1.5, 4.5]) {
                    const post = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.16, 1.35, 8), darkWoodMat);
                    post.position.set(side, 0.72, pz);
                    post.castShadow = true;
                    bridgeGroup.add(post);
                }
                const rail = new THREE.Mesh(new THREE.BoxGeometry(0.14, 0.14, 9.6), darkWoodMat);
                rail.position.set(side, 1.25, 0);
                bridgeGroup.add(rail);
            }

            this.scene.add(bridgeGroup);

            for (let wx = -75; wx <= 75; wx += 4) {
                if (Math.abs(wx) < 3.4) continue;
                const rz = 10.5 + Math.sin(wx * 0.08) * 2.5;
                this.colliders.push({ x: wx, z: rz, radius: 2.3 });
            }
        }

        _createMedievalHouse(x, z, rotY, options = {}) {
            const group = new THREE.Group();
            const y = this.getTerrainHeight(x, z);
            group.position.set(x, y, z);
            group.rotation.y = rotY;

            const w = options.width || 6.4;
            const d = options.depth || 5.4;
            const h = options.height || 3.4;
            const roofColor = options.roofColor || 0x8c3b2b;

            const stoneMat = new THREE.MeshStandardMaterial({ color: 0x78736a, roughness: 0.92 });
            const plasterMat = new THREE.MeshStandardMaterial({ color: 0xe6dcc8, roughness: 0.85 });
            const beamMat = new THREE.MeshStandardMaterial({ color: 0x4a2e1b, roughness: 0.88 });
            const roofMat = new THREE.MeshStandardMaterial({ color: roofColor, roughness: 0.78 });
            const windowMat = new THREE.MeshStandardMaterial({
                color: 0xffd166,
                emissive: 0xff9f1c,
                emissiveIntensity: 0.55
            });

            const base = new THREE.Mesh(new THREE.BoxGeometry(w + 0.3, 0.65, d + 0.3), stoneMat);
            base.position.y = 0.32;
            base.castShadow = true;
            base.receiveShadow = true;
            group.add(base);

            const walls = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), plasterMat);
            walls.position.y = 0.65 + h / 2;
            walls.castShadow = true;
            walls.receiveShadow = true;
            group.add(walls);

            for (const bx of [-w / 2, w / 2]) {
                for (const bz of [-d / 2, d / 2]) {
                    const beam = new THREE.Mesh(new THREE.BoxGeometry(0.28, h + 0.1, 0.28), beamMat);
                    beam.position.set(bx, 0.65 + h / 2, bz);
                    group.add(beam);
                }
            }

            const roofH = 2.6;
            const roofShape = new THREE.Shape();
            roofShape.moveTo(-w / 2 - 0.55, 0);
            roofShape.lineTo(w / 2 + 0.55, 0);
            roofShape.lineTo(0, roofH);
            roofShape.closePath();

            const roofGeo = new THREE.ExtrudeGeometry(roofShape, {
                depth: d + 0.9,
                bevelEnabled: false
            });
            roofGeo.translate(0, 0, -(d + 0.9) / 2);
            const roof = new THREE.Mesh(roofGeo, roofMat);
            roof.position.y = 0.65 + h;
            roof.castShadow = true;
            roof.receiveShadow = true;
            group.add(roof);
            this.occludables.push(roof);

            const chimney = new THREE.Mesh(new THREE.BoxGeometry(0.85, 2.5, 0.85), stoneMat);
            chimney.position.set(w * 0.28, 0.65 + h + 1.4, -d * 0.2);
            chimney.castShadow = true;
            group.add(chimney);

            const door = new THREE.Mesh(new THREE.BoxGeometry(1.15, 2.05, 0.2), beamMat);
            door.position.set(0, 1.35, d / 2 + 0.05);
            group.add(door);

            for (const wx of [-w * 0.28, w * 0.28]) {
                const win = new THREE.Mesh(new THREE.BoxGeometry(0.95, 0.95, 0.18), windowMat);
                win.position.set(wx, 2.35, d / 2 + 0.05);
                group.add(win);
            }

            this.scene.add(group);
            const r = Math.max(w, d) * 0.48;
            this.colliders.push({ x, z, radius: r });
        }

        _createOrganicTree(x, z, scale = 1.0, darkForest = false) {
            const group = new THREE.Group();
            const y = this.getTerrainHeight(x, z);
            group.position.set(x, y, z);

            const trunkMat = new THREE.MeshStandardMaterial({
                color: darkForest ? 0x3b281c : 0x593a24,
                roughness: 0.95
            });

            const trunk = new THREE.Mesh(
                new THREE.CylinderGeometry(0.24 * scale, 0.48 * scale, 3.4 * scale, 9),
                trunkMat
            );
            trunk.position.y = 1.7 * scale;
            trunk.castShadow = true;
            trunk.receiveShadow = true;
            group.add(trunk);

            const leafColors = darkForest
                ? [0x244722, 0x2f5c2b, 0x1d3b1c]
                : [0x3d7a32, 0x4e943e, 0x62ab4b];

            const canopyGroup = new THREE.Group();
            canopyGroup.position.y = 3.6 * scale;

            const blobs = [
                { x: 0, y: 0.8, z: 0, r: 1.95 },
                { x: -1.1, y: 0.1, z: 0.6, r: 1.45 },
                { x: 1.15, y: 0.15, z: -0.5, r: 1.5 },
                { x: 0.2, y: 0.2, z: 1.1, r: 1.4 },
                { x: -0.3, y: 1.65, z: -0.2, r: 1.35 }
            ];

            blobs.forEach((b, idx) => {
                const geo = new THREE.DodecahedronGeometry(b.r * scale, 1);
                const mat = new THREE.MeshStandardMaterial({
                    color: leafColors[idx % leafColors.length],
                    roughness: 0.85,
                    flatShading: true
                });
                const mesh = new THREE.Mesh(geo, mat);
                mesh.position.set(b.x * scale, b.y * scale, b.z * scale);
                mesh.castShadow = true;
                mesh.receiveShadow = true;
                canopyGroup.add(mesh);
                this.occludables.push(mesh);
            });

            group.add(canopyGroup);
            this.foliageClusters.push({ mesh: canopyGroup, phase: Math.random() * Math.PI * 2 });
            this.scene.add(group);
            this.colliders.push({ x, z, radius: 0.65 * scale });
        }

        _createRock(x, z, scale = 1.0) {
            const y = this.getTerrainHeight(x, z);
            const geo = new THREE.DodecahedronGeometry(0.9 * scale, 1);
            const pos = geo.attributes.position;
            for (let i = 0; i < pos.count; i++) {
                const vx = pos.getX(i);
                const vy = pos.getY(i);
                const vz = pos.getZ(i);
                const noise = 0.85 + Math.sin(vx * 4 + vz * 3) * 0.18;
                pos.setXYZ(i, vx * noise * 1.2, vy * noise * 0.75, vz * noise);
            }
            geo.computeVertexNormals();

            const mat = new THREE.MeshStandardMaterial({
                color: 0x7c807d,
                roughness: 0.92,
                flatShading: true
            });
            const rock = new THREE.Mesh(geo, mat);
            rock.position.set(x, y + 0.35 * scale, z);
            rock.castShadow = true;
            rock.receiveShadow = true;
            this.scene.add(rock);
            this.colliders.push({ x, z, radius: 0.85 * scale });
        }

        _createTorchPost(x, z) {
            const y = this.getTerrainHeight(x, z);
            const group = new THREE.Group();
            group.position.set(x, y, z);

            const woodMat = new THREE.MeshStandardMaterial({ color: 0x4a2e1b, roughness: 0.9 });
            const post = new THREE.Mesh(new THREE.CylinderGeometry(0.11, 0.14, 2.5, 8), woodMat);
            post.position.y = 1.25;
            post.castShadow = true;
            group.add(post);

            const flameMat = new THREE.MeshBasicMaterial({ color: 0xff9f1c });
            const flame = new THREE.Mesh(new THREE.OctahedronGeometry(0.24, 0), flameMat);
            flame.position.y = 2.65;
            group.add(flame);

            const light = new THREE.PointLight(0xff9636, 1.35, 14);
            light.position.set(0, 2.8, 0);
            group.add(light);

            this.torchLights.push({ light, flame, phase: Math.random() * 10 });
            this.scene.add(group);
        }

        _createBarrelOrCrate(x, z, isBarrel = true) {
            const y = this.getTerrainHeight(x, z);
            const mat = new THREE.MeshStandardMaterial({
                color: isBarrel ? 0x7c4d2b : 0x9c6b3e,
                roughness: 0.86
            });
            const geo = isBarrel
                ? new THREE.CylinderGeometry(0.42, 0.38, 0.95, 10)
                : new THREE.BoxGeometry(0.85, 0.85, 0.85);
            const mesh = new THREE.Mesh(geo, mat);
            mesh.position.set(x, y + 0.45, z);
            mesh.castShadow = true;
            mesh.receiveShadow = true;
            this.scene.add(mesh);
            this.colliders.push({ x, z, radius: 0.5 });
        }

        _buildVillage() {
            const wellGroup = new THREE.Group();
            wellGroup.position.set(0, this.getTerrainHeight(0, 38), 38);
            const stoneMat = new THREE.MeshStandardMaterial({ color: 0x858077, roughness: 0.9 });
            const rim = new THREE.Mesh(new THREE.CylinderGeometry(1.45, 1.55, 0.95, 14), stoneMat);
            rim.position.y = 0.48;
            rim.castShadow = true;
            wellGroup.add(rim);

            const waterDisk = new THREE.Mesh(
                new THREE.CylinderGeometry(1.18, 1.18, 0.1, 14),
                new THREE.MeshStandardMaterial({ color: 0x1d6fa3, roughness: 0.2 })
            );
            waterDisk.position.y = 0.65;
            wellGroup.add(waterDisk);

            const woodMat = new THREE.MeshStandardMaterial({ color: 0x593a24, roughness: 0.85 });
            for (const sx of [-1.25, 1.25]) {
                const p = new THREE.Mesh(new THREE.BoxGeometry(0.18, 2.2, 0.18), woodMat);
                p.position.set(sx, 1.5, 0);
                wellGroup.add(p);
            }
            const roof = new THREE.Mesh(
                new THREE.ConeGeometry(1.85, 1.1, 4),
                new THREE.MeshStandardMaterial({ color: 0x7c3626, roughness: 0.8 })
            );
            roof.position.y = 2.95;
            roof.rotation.y = Math.PI / 4;
            wellGroup.add(roof);
            this.scene.add(wellGroup);
            this.colliders.push({ x: 0, z: 38, radius: 1.65 });

            this._createMedievalHouse(-15, 44, Math.PI * 0.35, { roofColor: 0x8c3b2b, width: 6.8, depth: 5.5 });
            this._createMedievalHouse(15, 45, -Math.PI * 0.35, { roofColor: 0x2f5d7c, width: 6.5, depth: 5.2 });
            this._createMedievalHouse(-16, 28, Math.PI * 0.5, { roofColor: 0x6e472b, width: 6.2, depth: 5.0 });
            this._createMedievalHouse(16, 28, -Math.PI * 0.5, { roofColor: 0x3b6e4c, width: 6.0, depth: 5.0 });
            this._createMedievalHouse(-11, 56, Math.PI * 0.15, { roofColor: 0x8c3b2b, width: 5.8, depth: 4.8 });

            const awningMat = new THREE.MeshStandardMaterial({ color: 0xc94a38, roughness: 0.8 });
            const stall = new THREE.Mesh(new THREE.BoxGeometry(3.2, 0.25, 1.8), awningMat);
            stall.position.set(11.5, this.getTerrainHeight(11.5, 31) + 2.3, 31);
            stall.rotation.z = 0.15;
            stall.castShadow = true;
            this.scene.add(stall);

            this._createBarrelOrCrate(-12.2, 31.5, true);

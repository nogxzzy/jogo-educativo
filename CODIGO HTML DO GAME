    <script>
    window.Ragnarok25D = window.Ragnarok25D || {};

    /* ==========================================================================
       1. SpriteFactory — Spritesheets pixel-art 4 direções, retratos e ícones
       ========================================================================== */
    class SpriteFactory {
        constructor() {
            this.cache = new Map();
            this.portraitCache = new Map();
            this.iconCache = new Map();
        }

        getCharacterTexture(type) {
            if (this.cache.has(type)) return this.cache.get(type);

            const frameSize = 128;
            const cols = 8;
            const rows = 4;
            const canvas = document.createElement('canvas');
            canvas.width = frameSize * cols;
            canvas.height = frameSize * rows;
            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingEnabled = false;

            for (let dir = 0; dir < rows; dir++) {
                for (let col = 0; col < cols; col++) {
                    ctx.save();
                    ctx.translate(col * frameSize, dir * frameSize);
                    this._drawCharacterFrame(ctx, type, dir, col, frameSize);
                    ctx.restore();
                }
            }

            const texture = new THREE.CanvasTexture(canvas);
            texture.magFilter = THREE.NearestFilter;
            texture.minFilter = THREE.LinearFilter;
            texture.colorSpace = THREE.SRGBColorSpace;
            texture.needsUpdate = true;

            this.cache.set(type, texture);
            return texture;
        }

        getPortraitDataURL(type) {
            if (this.portraitCache.has(type)) return this.portraitCache.get(type);

            const canvas = document.createElement('canvas');
            canvas.width = 96;
            canvas.height = 96;
            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingEnabled = false;

            const grad = ctx.createLinearGradient(0, 0, 0, 96);
            grad.addColorStop(0, '#2c2219');
            grad.addColorStop(1, '#17110c');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 96, 96);

            ctx.save();
            ctx.translate(-16, 4);
            this._drawCharacterFrame(ctx, type, 0, 0, 128, true);
            ctx.restore();

            const url = canvas.toDataURL();
            this.portraitCache.set(type, url);
            return url;
        }

        _drawCharacterFrame(ctx, type, dir, col, size, isPortrait = false) {
            if (!isPortrait) {
                ctx.fillStyle = 'rgba(10, 14, 10, 0.38)';
                ctx.beginPath();
                ctx.ellipse(64, 114, col === 7 ? 28 : 20, 7, 0, 0, Math.PI * 2);
                ctx.fill();
            }

            const isHurt = col === 7;
            const isAttack = col === 6;
            const walkPhase = col >= 2 && col <= 5 ? col - 2 : -1;
            const idlePhase = col === 1 ? 1 : 0;

            let bobY = 0;
            if (idlePhase === 1) bobY = 2;
            if (walkPhase === 0 || walkPhase === 2) bobY = -3;
            if (walkPhase === 1 || walkPhase === 3) bobY = 1;
            if (isAttack) bobY = -2;

            const cfg = this._getPresetConfig(type);

            ctx.save();
            if (isHurt && !isPortrait) {
                ctx.translate(dir === 1 ? 6 : -6, 4);
            }

            if (cfg.scale && !isPortrait) {
                ctx.translate(64, 114);
                ctx.scale(cfg.scale, cfg.scale);
                ctx.translate(-64, -114);
            }

            const cx = 64;
            const baseY = 110 + bobY;

            const flipX = dir === 2;
            ctx.save();
            if (flipX) {
                ctx.translate(cx * 2, 0);
                ctx.scale(-1, 1);
            }

            const sideView = (dir === 1 || dir === 2);
            const backView = (dir === 3);

            // Capa traseira
            if (cfg.cloakColor && !backView) {
                this._pxRect(ctx, cx - 18, baseY - 52, 36, 36, cfg.cloakDark, '#141210');
            }

            // Pernas e Botas
            const leftLegOffset = walkPhase === 0 ? -5 : walkPhase === 2 ? 5 : 0;
            const rightLegOffset = walkPhase === 0 ? 5 : walkPhase === 2 ? -5 : 0;

            if (sideView) {
                this._pxRect(ctx, cx - 6 + rightLegOffset, baseY - 22, 10, 14, cfg.pantsColor, '#181412');
                this._pxRect(ctx, cx - 7 + rightLegOffset, baseY - 10, 12, 10, cfg.bootColor, '#181412');
                this._pxRect(ctx, cx - 4 + leftLegOffset, baseY - 22, 10, 14, cfg.pantsColor, '#181412');
                this._pxRect(ctx, cx - 5 + leftLegOffset, baseY - 10, 12, 10, cfg.bootColor, '#181412');
            } else {
                this._pxRect(ctx, cx - 13, baseY - 22 + Math.min(0, leftLegOffset), 10, 14, cfg.pantsColor, '#181412');
                this._pxRect(ctx, cx - 14, baseY - 10 + Math.min(0, leftLegOffset), 11, 10, cfg.bootColor, '#181412');
                this._pxRect(ctx, cx + 3, baseY - 22 + Math.min(0, rightLegOffset), 10, 14, cfg.pantsColor, '#181412');
                this._pxRect(ctx, cx + 3, baseY - 10 + Math.min(0, rightLegOffset), 11, 10, cfg.bootColor, '#181412');
            }

            // Tronco / Armadura / Túnica
            const torsoW = sideView ? 22 : 30;
            const torsoX = cx - torsoW / 2;
            this._pxRect(ctx, torsoX, baseY - 52, torsoW, 31, cfg.armorMain, '#181412');
            if (cfg.armorTrim) {
                this._pxRect(ctx, torsoX + 4, baseY - 49, torsoW - 8, 18, cfg.armorTrim, null);
            }
            if (cfg.emblem === 'ifpi' && !backView) {
                ctx.fillStyle = '#1f8a4c';
                ctx.fillRect(cx - 4, baseY - 45, 3, 3);
                ctx.fillRect(cx, baseY - 45, 3, 3);
                ctx.fillRect(cx - 4, baseY - 41, 3, 3);
                ctx.fillRect(cx - 4, baseY - 37, 3, 3);
                ctx.fillRect(cx, baseY - 37, 3, 3);
                ctx.fillStyle = '#d93829';
                ctx.fillRect(cx - 4, baseY - 49, 3, 3);
            } else if (cfg.emblem === 'crest' && !backView) {
                ctx.fillStyle = '#e5b94c';
                ctx.fillRect(cx - 3, baseY - 46, 6, 8);
            }

            // Cinto
            this._pxRect(ctx, torsoX, baseY - 26, torsoW, 5, '#4a2e1b', '#181412');
            if (!backView) {
                ctx.fillStyle = '#f2c94c';
                ctx.fillRect(cx - 3, baseY - 26, 6, 5);
            }

            // Capa nas costas
            if (cfg.cloakColor && backView) {
                this._pxRect(ctx, cx - 18, baseY - 52, 36, 38, cfg.cloakColor, '#141210');
                if (cfg.emblem === 'ifpi') {
                    ctx.fillStyle = '#e8ece6';
                    ctx.fillRect(cx - 6, baseY - 42, 12, 12);
                    ctx.fillStyle = '#1f8a4c';
                    ctx.fillRect(cx - 4, baseY - 40, 3, 8);
                    ctx.fillRect(cx + 1, baseY - 36, 3, 4);
                }
            }

            // Ombreiras
            if (cfg.pauldronColor) {
                if (sideView) {
                    this._pxRect(ctx, cx - 10, baseY - 54, 18, 11, cfg.pauldronColor, '#181412');
                } else {
                    this._pxRect(ctx, cx - 21, baseY - 54, 11, 11, cfg.pauldronColor, '#181412');
                    this._pxRect(ctx, cx + 10, baseY - 54, 11, 11, cfg.pauldronColor, '#181412');
                }
            }

            // Braços
            const armSwing = isAttack ? -10 : (walkPhase === 0 ? 4 : walkPhase === 2 ? -4 : 0);
            if (!sideView) {
                this._pxRect(ctx, cx - 20, baseY - 45 - armSwing * 0.5, 7, 17, cfg.gloveColor, '#181412');
                this._pxRect(ctx, cx + 13, baseY - 45 + armSwing, 7, 17, cfg.gloveColor, '#181412');
            } else {
                this._pxRect(ctx, cx - 4, baseY - 45 + armSwing, 8, 17, cfg.gloveColor, '#181412');
            }

            // Escudo
            if (cfg.hasShield && !backView) {
                const sx = sideView ? cx + 4 : cx - 26;
                const sy = baseY - 44;
                this._pxRect(ctx, sx, sy, 13, 18, '#6a7885', '#181412');
                ctx.fillStyle = '#d4a843';
                ctx.fillRect(sx + 2, sy + 2, 9, 14);
                ctx.fillStyle = '#2d4b73';
                ctx.fillRect(sx + 4, sy + 4, 5, 10);
            }

            if (cfg.weapon) {
                this._drawWeapon(ctx, cfg.weapon, cx, baseY, dir, isAttack);
            }

            // Cabeça e Rosto (Cavaleiro sem capacete com cabelos visíveis)
            const headY = baseY - 78;
            this._pxRect(ctx, cx - 14, headY, 28, 26, cfg.skinColor, '#181412');

            if (cfg.isGoblin) {
                this._pxRect(ctx, cx - 21, headY + 8, 7, 6, cfg.skinColor, '#181412');
                this._pxRect(ctx, cx + 14, headY + 8, 7, 6, cfg.skinColor, '#181412');
            }

            if (!backView) {
                const eyeOffsetX = sideView ? -4 : 0;
                ctx.fillStyle = '#14110f';
                if (!sideView) {
                    ctx.fillRect(cx - 8, headY + 12, 4, 6);
                    ctx.fillRect(cx + 4, headY + 12, 4, 6);
                    ctx.fillStyle = cfg.eyeHighlight || '#ffffff';
                    ctx.fillRect(cx - 8, headY + 12, 2, 2);
                    ctx.fillRect(cx + 4, headY + 12, 2, 2);
                } else {
                    ctx.fillRect(cx - 9 + eyeOffsetX, headY + 12, 4, 6);
                    ctx.fillStyle = cfg.eyeHighlight || '#ffffff';
                    ctx.fillRect(cx - 9 + eyeOffsetX, headY + 12, 2, 2);
                }

                ctx.fillStyle = cfg.hairDark;
                if (!sideView) {
                    ctx.fillRect(cx - 9, headY + 9, 6, 2);
                    ctx.fillRect(cx + 3, headY + 9, 6, 2);
                } else {
                    ctx.fillRect(cx - 10 + eyeOffsetX, headY + 9, 6, 2);
                }
            }

            if (cfg.crown) {
                this._pxRect(ctx, cx - 14, headY - 8, 28, 9, '#f2c138', '#181412');
                ctx.fillStyle = '#d93636';
                ctx.fillRect(cx - 2, headY - 5, 4, 4);
            } else if (cfg.hairColor) {
                this._pxRect(ctx, cx - 16, headY - 7, 32, 12, cfg.hairColor, '#181412');
                if (!backView) {
                    ctx.fillStyle = cfg.hairColor;
                    ctx.fillRect(cx - 14, headY + 3, 6, 6);
                    ctx.fillRect(cx - 3, headY + 3, 7, 7);
                    ctx.fillRect(cx + 8, headY + 3, 6, 6);
                } else {
                    this._pxRect(ctx, cx - 15, headY + 2, 30, 18, cfg.hairColor, '#181412');
                }
                this._pxRect(ctx, cx - 16, headY + 3, 4, 14, cfg.hairDark, null);
                this._pxRect(ctx, cx + 12, headY + 3, 4, 14, cfg.hairDark, null);
            }

            if (cfg.beardColor && !backView) {
                this._pxRect(ctx, cx - 10, headY + 19, 20, 12, cfg.beardColor, '#181412');
            }

            if (isHurt) {
                ctx.fillStyle = 'rgba(235, 50, 50, 0.35)';
                ctx.fillRect(cx - 24, headY - 10, 48, 86);
            }

            ctx.restore();
            ctx.restore();
        }

        _drawWeapon(ctx, weapon, cx, baseY, dir, isAttack) {
            ctx.save();
            if (weapon === 'sword') {
                if (isAttack) {
                    this._pxRect(ctx, cx - 34, baseY - 38, 32, 6, '#e6eef8', '#1b263b');
                    ctx.fillStyle = '#d4a843';
                    ctx.fillRect(cx - 6, baseY - 41, 4, 12);
                    ctx.strokeStyle = 'rgba(180, 230, 255, 0.85)';
                    ctx.lineWidth = 4;
                    ctx.beginPath();
                    ctx.arc(cx - 6, baseY - 35, 34, Math.PI * 0.65, Math.PI * 1.35);
                    ctx.stroke();
                } else {
                    this._pxRect(ctx, cx + 15, baseY - 58, 5, 28, '#dce6f2', '#1b263b');
                    ctx.fillStyle = '#d4a843';
                    ctx.fillRect(cx + 12, baseY - 32, 11, 4);
                }
            } else if (weapon === 'club') {
                const offset = isAttack ? -16 : 0;
                this._pxRect(ctx, cx + 14 + offset, baseY - 52, 8, 24, '#7c5332', '#181412');
            } else if (weapon === 'greatsword') {
                const offset = isAttack ? -24 : 0;
                this._pxRect(ctx, cx + 14 + offset, baseY - 64, 8, 36, '#b8c4d0', '#181412');
                ctx.fillStyle = '#c94a38';
                ctx.fillRect(cx + 11 + offset, baseY - 30, 14, 4);
            } else if (weapon === 'bow') {
                ctx.strokeStyle = '#8b5a2b';
                ctx.lineWidth = 4;
                ctx.beginPath();
                ctx.arc(cx - 12, baseY - 36, 16, Math.PI * 0.6, Math.PI * 1.4);
                ctx.stroke();
                ctx.strokeStyle = '#e8dec8';
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.moveTo(cx - 16, baseY - 51);
                ctx.lineTo(cx - 16, baseY - 21);
                ctx.stroke();
            } else if (weapon === 'hammer') {
                this._pxRect(ctx, cx + 15, baseY - 50, 5, 24, '#6e472b', '#181412');
                this._pxRect(ctx, cx + 10, baseY - 56, 15, 10, '#5a6572', '#181412');
            } else if (weapon === 'staff') {
                this._pxRect(ctx, cx + 15, baseY - 60, 4, 38, '#8a5a36', '#181412');
                ctx.fillStyle = '#4cc9f0';
                ctx.fillRect(cx + 14, baseY - 64, 6, 6);
            }
            ctx.restore();
        }

        _pxRect(ctx, x, y, w, h, fill, outline) {
            if (outline) {
                ctx.fillStyle = outline;
                ctx.fillRect(Math.round(x - 2), Math.round(y - 2), Math.round(w + 4), Math.round(h + 4));
            }
            ctx.fillStyle = fill;
            ctx.fillRect(Math.round(x), Math.round(y), Math.round(w), Math.round(h));
        }

        _getPresetConfig(type) {
            const presets = {
                knight: {

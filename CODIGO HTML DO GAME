    class DialogueSystem {
        constructor(spriteFactory, audioManager) {
            this.spriteFactory = spriteFactory;
            this.audioManager = audioManager;
            this.isOpen = false;
            this.currentNPC = null;
            this.lines = [];
            this.lineIndex = 0;
            this.actions = [];

            this.panel = document.getElementById('dialogue-box');
            this.nameEl = document.getElementById('dialogue-npc-name');
            this.roleEl = document.getElementById('dialogue-npc-role');
            this.portraitEl = document.getElementById('dialogue-portrait');
            this.textEl = document.getElementById('dialogue-text');
            this.actionsEl = document.getElementById('dialogue-actions');
        }

        open(npc, lines, actions = []) {
            this.isOpen = true;
            this.currentNPC = npc;
            this.lines = lines;
            this.lineIndex = 0;
            this.actions = actions;

            this.nameEl.textContent = npc.name;
            this.roleEl.textContent = npc.role;
            this.portraitEl.src = this.spriteFactory.getPortraitDataURL(npc.spriteType);

            this.panel.classList.remove('hidden');
            if (this.audioManager) this.audioManager.playSFX('ui_open');
            this._renderCurrentLine();
        }

        advance() {
            if (!this.isOpen) return;
            if (this.lineIndex < this.lines.length - 1) {
                this.lineIndex++;
                if (this.audioManager) this.audioManager.playSFX('ui_click');
                this._renderCurrentLine();
            } else if (this.actions.length === 0) {
                this.close();
            }
        }

        close() {
            this.isOpen = false;
            this.currentNPC = null;
            this.panel.classList.add('hidden');
            if (this.audioManager) this.audioManager.playSFX('ui_click');
        }

        _renderCurrentLine() {
            this.textEl.textContent = this.lines[this.lineIndex];
            this.actionsEl.innerHTML = '';

            const isLast = this.lineIndex >= this.lines.length - 1;
            if (!isLast) {
                const nextBtn = document.createElement('button');
                nextBtn.className = 'ro-btn primary';
                nextBtn.textContent = 'Continuar [Espaço / E]';
                nextBtn.onclick = () => this.advance();
                this.actionsEl.appendChild(nextBtn);
            } else {
                for (const act of this.actions) {
                    const btn = document.createElement('button');
                    btn.className = `ro-btn ${act.primary ? 'primary' : ''}`;
                    btn.textContent = act.label;
                    btn.onclick = () => {
                        if (act.onClick) act.onClick();
                    };
                    this.actionsEl.appendChild(btn);
                }
                const closeBtn = document.createElement('button');
                closeBtn.className = 'ro-btn';
                closeBtn.textContent = 'Encerrar Conversa [ESC]';
                closeBtn.onclick = () => this.close();
                this.actionsEl.appendChild(closeBtn);
            }
        }
    }


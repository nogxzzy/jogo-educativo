    class PlayerController {
        constructor(scene, spriteFactory, worldManager, expSystem, equipmentSystem) {
            this.scene = scene;
            this.spriteFactory = spriteFactory;
            this.worldManager = worldManager;
            this.expSystem = expSystem;
            this.equipmentSystem = equipmentSystem;

            this.name = 'Sir Aldren';
            this.skinType = 'knight';

            const tex = this.spriteFactory.getCharacterTexture(this.skinType);
            this.animator = new SpriteAnimator(scene, tex, {
                width: 2.55,
                height: 2.55
            });

            this.pos = new THREE.Vector3(0, worldManager.getTerrainHeight(0, 44), 44);
            this.animator.setPosition(this.pos.x, this.pos.y, this.pos.z);

            const derived = this.getDerivedStats();
            this.maxHp = derived.maxHp;
            this.hp = this.maxHp;
            this.maxSp = derived.maxSp;
            this.sp = this.maxSp;

            this.attackCooldown = 0;
            this.dodgeCooldown = 0;
            this.dodgeTimer = 0;
            this.dodgeDir = new THREE.Vector2(0, 1);
            this.invulnTimer = 0;
            this.stepSoundTimer = 0;
            this.isDead = false;
        }

        setSkin(skinType) {
            if (this.skinType === skinType) return;
            this.skinType = skinType;
            const tex = this.spriteFactory.getCharacterTexture(skinType);
            this.animator.dispose();
            this.animator = new SpriteAnimator(this.scene, tex, {
                width: 2.55,
                height: 2.55
            });
            this.animator.setPosition(this.pos.x, this.pos.y, this.pos.z);
        }

        getDerivedStats() {
            return this.expSystem.computeDerivedStats(this.equipmentSystem.getTotalBonuses());
        }

        recalculateVitals(healFull = false) {
            const d = this.getDerivedStats();
            this.maxHp = d.maxHp;
            this.maxSp = d.maxSp;
            if (healFull) {
                this.hp = this.maxHp;
                this.sp = this.maxSp;
            } else {
                this.hp = Math.min(this.hp, this.maxHp);
                this.sp = Math.min(this.sp, this.maxSp);
            }
        }

        triggerDodge() {
            if (this.isDead || this.dodgeCooldown > 0 || this.dodgeTimer > 0) return false;
            this.dodgeTimer = 0.22;
            this.dodgeCooldown = 0.95;
            this.invulnTimer = 0.32;
            const angle = this.animator.facingAngle;
            this.dodgeDir.set(Math.sin(angle), Math.cos(angle));
            return true;
        }

        update(dt, keys, cameraYaw, audioManager, uiLocked) {
            if (this.isDead) {
                this.animator.setState('dead');
                this.animator.update(dt, cameraYaw);
                return;
            }

            const derived = this.getDerivedStats();
            this.maxHp = derived.maxHp;
            this.maxSp = derived.maxSp;

            this.hp = Math.min(this.maxHp, this.hp + dt * 1.4);
            this.sp = Math.min(this.maxSp, this.sp + dt * 2.2);

            if (this.attackCooldown > 0) this.attackCooldown -= dt;
            if (this.dodgeCooldown > 0) this.dodgeCooldown -= dt;
            if (this.invulnTimer > 0) this.invulnTimer -= dt;

            let moveX = 0;
            let moveZ = 0;

            if (!uiLocked) {
                if (keys['KeyW'] || keys['ArrowUp']) moveZ -= 1;
                if (keys['KeyS'] || keys['ArrowDown']) moveZ += 1;
                if (keys['KeyA'] || keys['ArrowLeft']) moveX -= 1;
                if (keys['KeyD'] || keys['ArrowRight']) moveX += 1;
            }

            if (this.dodgeTimer > 0) {
                this.dodgeTimer -= dt;
                const dashSpeed = derived.moveSpeed * 2.35;
                this.pos.x += this.dodgeDir.x * dashSpeed * dt;
                this.pos.z += this.dodgeDir.y * dashSpeed * dt;
                this.animator.setState('walk');
            } else if (moveX !== 0 || moveZ !== 0) {
                const len = Math.hypot(moveX, moveZ);
                const nx = moveX / len;
                const nz = moveZ / len;

                const sin = Math.sin(cameraYaw);
                const cos = Math.cos(cameraYaw);
                const worldDX = nx * cos + nz * sin;
                const worldDZ = -nx * sin + nz * cos;

                this.pos.x += worldDX * derived.moveSpeed * dt;
                this.pos.z += worldDZ * derived.moveSpeed * dt;

                this.animator.facingAngle = Math.atan2(worldDX, worldDZ);
                if (this.animator.state !== 'attack' && this.animator.state !== 'hurt') {
                    this.animator.setState('walk');
                }

                this.stepSoundTimer -= dt;
                if (this.stepSoundTimer <= 0) {
                    this.stepSoundTimer = 0.34;
                    if (audioManager) audioManager.playSFX('step');
                }
            } else {
                if (this.animator.state === 'walk') {
                    this.animator.setState('idle');
                }
            }

            this.worldManager.resolveCollisions(this.pos, 0.55);
            this.pos.y = this.worldManager.getTerrainHeight(this.pos.x, this.pos.z);
            this.animator.setPosition(this.pos.x, this.pos.y, this.pos.z);
            this.animator.update(dt, cameraYaw);
        }

        respawnAtVillage() {
            this.isDead = false;
            this.pos.set(0, this.worldManager.getTerrainHeight(0, 44), 44);
            this.recalculateVitals(true);
            this.animator.setState('idle');
            this.animator.setPosition(this.pos.x, this.pos.y, this.pos.z);
        }
    }

